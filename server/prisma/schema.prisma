model ShopWorkOrder {
  id              String              @id @default(uuid())
  workOrderNumber String              @unique @map("work_order_number")
  status          ShopWorkOrderStatus @default(intake)

  // Customer (can be Basin Safety for internal work)
  companyId  String  @map("company_id")
  isInternal Boolean @default(false) @map("is_internal")

  // Billing
  poNumber  String? @map("po_number")
  afeNumber String? @map("afe_number")
  // Tier 1 reservation billing — checkbox set at intake. Shop WOs have no pad,
  // so this WO-level flag (not Pad.tier1) drives the 5% reservation fee + the
  // Pale Horse QB customer override at invoice time. See services/billingRules.ts.
  tier1     Boolean @default(false) @map("tier_1")

  // Intake info
  intakeDate   DateTime @map("intake_date") @db.Date
  intakeNotes  String?  @map("intake_notes")
  intakeById   String?  @map("intake_by_id")
  // The Basin Site this WO was received at (replaces the Wave 2 originShop
  // enum). Also the default Site for new items added to the order.
  intakeSiteId String   @map("intake_site_id")

  // Wave 2 — optional Pad pointers. Populated when:
  //   sourceLocationId: a Basin tech picked the gear up from a customer site
  //                     (closes the field-inspection-to-shop handoff). NULL
  //                     when the customer dropped it off at a Basin shop.
  //   returnLocationId: gear is going back to a different pad than it came
  //                     from. NULL = same as source = customer counter pickup.
  sourceLocationId String? @map("source_location_id")
  returnLocationId String? @map("return_location_id")

  // Inter-site transfer (Phase 5). While transitToSiteId is set, the WO is
  // "leaving but not yet received" — items stay at their current Site until
  // the destination confirms arrival. Cleared on receive.
  transitToSiteId      String?   @map("transit_to_site_id")
  transitInitiatedAt   DateTime? @map("transit_initiated_at")
  transitInitiatedById String?   @map("transit_initiated_by_id")

  // Auto-transit that was ASKED FOR and could not be honored. Field-inspection
  // spawns name their destination Site by short code (the tech's "return to
  // shop" pick); when that code resolves to nothing, or to a deactivated Site,
  // the WO is still created but no ShopTransferEvent is — so the gear never
  // appears in anyone's Incoming column. These three record that miss so it is
  // countable on the Ops Dashboard instead of silent. All three are set and
  // cleared together; NULL reason = no failed request.
  transitFailedShortCode String?                    @map("transit_failed_short_code")
  transitFailedReason    ShopTransitFailureReason?  @map("transit_failed_reason")
  transitFailedAt        DateTime?                  @map("transit_failed_at")

  // Expected return
  promisedDate DateTime? @map("promised_date") @db.Date
  priority     Int       @default(5) // 1=urgent, 5=normal, 10=low

  // Completion
  completedDate DateTime? @map("completed_date") @db.Date
  returnedDate  DateTime? @map("returned_date") @db.Date

  // Drop-off contact (person bringing equipment in)
  dropOffContactName      String? @map("drop_off_contact_name")
  dropOffContactPhone     String? @map("drop_off_contact_phone")
  dropOffContactEmail     String? @map("drop_off_contact_email")
  dropOffContactPreferred String? @map("drop_off_contact_preferred") // 'call' | 'text' | 'email'

  // Pickup contact ("who do we call when it's ready")
  pickupContactName      String? @map("pickup_contact_name")
  pickupContactPhone     String? @map("pickup_contact_phone")
  pickupContactEmail     String? @map("pickup_contact_email")
  pickupContactPreferred String? @map("pickup_contact_preferred") // 'call' | 'text' | 'email'

  // Customer-contact log (chasing pickup). Append-only; recording a contact
  // does NOT change status. Shape: [{ id, method, note, contactedAt,
  // enteredById, enteredByName, createdAt }]. method = call|email|text|in_person|other.
  contactLog Json? @map("contact_log") @db.JsonB

  // Pickup / Release (signature at release)
  pickupSignedByName String?   @map("pickup_signed_by_name")
  pickupSignature    String?   @map("pickup_signature") @db.Text
  pickupSignedAt     DateTime? @map("pickup_signed_at")
  pickupNotes        String?   @map("pickup_notes")

  // Denormalized counts for quick display
  totalItems     Int @default(0) @map("total_items")
  completedItems Int @default(0) @map("completed_items")

  // Category hint (items may be mixed)
  primaryCategory EquipmentCategoryShop? @map("primary_category")

  notes      String?
  customData Json?   @map("custom_data") @db.JsonB

  // WO-level billing extras that belong to the whole order, not a single unit
  // (mileage/trip charge + order-level misc). Billed ONCE across per-unit
  // sweeps: `billedTicketId` is stamped on the first sweep that emits them so
  // re-runs never duplicate the trip charge.
  //   { mileage: { miles, rate } | { flat } | null,
  //     misc: [{ description, amount }],
  //     billedTicketId: string | null }
  billingExtras Json? @map("billing_extras") @db.JsonB

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")


  // ── WI-08: paid at drop ────────────────────────────────────────────────
  //
  // A monitor calibration is paid at the counter and must never join the
  // standard billing queue. This records WHICH counter path collected it;
  // HOW MUCH is deliberately NOT stored here -- it is derived from the
  // Payment rows, so a refund, a second payment, or added work cannot leave a
  // stale number sitting on the ticket contradicting them.
  //
  // Exemption is therefore a claim about the ROUTE, not about the balance.
  // Whether the ticket actually stays out of the queue is decided by
  // services/paidAtDrop.ts comparing what was collected against the total --
  // which means added work re-enters the queue on its own, for the delta,
  // with no flag for anybody to remember to clear.
  paidAtDropVia PaidAtDropMethod? @map("paid_at_drop_via")

  /// The Lightspeed (in-store POS) transaction number. Lightspeed -> QB is
  /// re-keyed by hand and stays that way for now; this exists so the manual
  /// entry is reconcilable against the ticket at all.
  lightspeedTxnNumber String? @map("lightspeed_txn_number")

  // Relations
  company            Company             @relation(fields: [companyId], references: [id])
  intakeBy           User?               @relation("ShopIntakeBy", fields: [intakeById], references: [id])
  intakeSite         Site                @relation(fields: [intakeSiteId], references: [id])
  createdBy          User?               @relation("ShopWOCreator", fields: [createdById], references: [id])
  items              ShopWorkOrderItem[]
  qaEvents           ShopQaEvent[]
  contactEntries     ShopContactLogEntry[]
  payments           Payment[]
  printJobs          PrintJob[]
  sourceLocation     Pad?                @relation("ShopWOSourcePad", fields: [sourceLocationId], references: [id])
  returnLocation     Pad?                @relation("ShopWOReturnPad", fields: [returnLocationId], references: [id])
  transfers          ShopTransferEvent[]
  transitToSite      Site?               @relation("ShopWOTransitToSite", fields: [transitToSiteId], references: [id])
  transitInitiatedBy User?               @relation("ShopWOTransitInitiatedBy", fields: [transitInitiatedById], references: [id])

  @@index([transitToSiteId])
  @@index([transitFailedReason])
  @@map("shop_work_orders")
}

model ShopWorkOrderItem {
  id          String @id @default(uuid())
  workOrderId String @map("work_order_id")
  itemNumber  Int    @map("item_number")
  siteId      String @map("site_id") // current physical Site of this item; moves on inter-site transfer

  // Equipment identity
  serializedEquipmentId String?               @map("serialized_equipment_id")
  serialNumber          String                @map("serial_number")
  equipmentCategory     EquipmentCategoryShop @map("equipment_category")
  productId             String?               @map("product_id")
  equipmentDescription  String?               @map("equipment_description")

  // FEX-specific fields (fire extinguishers)
  fexBrand String? @map("fex_brand")
  fexSize  String? @map("fex_size")
  fexType  String? @map("fex_type")

  // Service details
  serviceType   ShopServiceType @map("service_type")
  reportedIssue String?         @map("reported_issue")
  status        ShopItemStatus  @default(received)

  // Diagnosis
  diagnosisNotes String?   @map("diagnosis_notes")
  diagnosedById  String?   @map("diagnosed_by_id")
  diagnosedAt    DateTime? @map("diagnosed_at")

  // Quote / Approval
  estimatedCost   Decimal?  @map("estimated_cost") @db.Decimal(12, 2)
  quoteSentAt     DateTime? @map("quote_sent_at")
  quoteApprovedAt DateTime? @map("quote_approved_at")
  quoteDeclinedAt DateTime? @map("quote_declined_at")

  // Work
  assignedToId    String?   @map("assigned_to_id")
  workNotes       String?   @map("work_notes")
  workCompletedAt DateTime? @map("work_completed_at")

  // Warranty / Outside Service tracking
  isWarranty        Boolean         @default(false) @map("is_warranty")
  warrantyVendor    String?         @map("warranty_vendor")
  sentOutDate       DateTime?       @map("sent_out_date") @db.Date
  sentOutMethod     ShipmentMethod? @map("sent_out_method")
  sentOutTracking   String?         @map("sent_out_tracking")
  sentOutTo         String?         @map("sent_out_to")
  receivedBackDate  DateTime?       @map("received_back_date") @db.Date
  receivedBackNotes String?         @map("received_back_notes")

  // QC
  qcTestedById  String?     @map("qc_tested_by_id")
  qcResult      TestResult? @map("qc_result")
  qcNotes       String?     @map("qc_notes")
  qcCompletedAt DateTime?   @map("qc_completed_at")

  // Return
  returnedAt   DateTime?     @map("returned_at")
  returnMethod ReturnMethod? @map("return_method")

  // ── WI-09: the external-vendor receive step ─────────────────────────────
  //
  // Transfer-out, tracking and receive-back already worked. What the receive
  // moment did not capture was anything billing could act on without opening
  // a PDF.
  //
  // REQUIRED TO RECEIVE. A unit cannot come back from a vendor without a
  // disposition -- not because the tech always knows, but because "nobody
  // decided" is indistinguishable from "non-billable" once the unit is back on
  // the shelf, and it silently resolves in the customer's favour every time.
  vendorDisposition ShopVendorDisposition? @map("vendor_disposition")

  /// The vendor's invoice number, for matching against what AP receives.
  vendorInvoiceNumber String? @map("vendor_invoice_number")

  /// The KEYED total. Billing gets a number without opening the PDF, and this
  /// is the ONLY place a number for this work legitimately comes from.
  vendorInvoiceTotal Decimal? @map("vendor_invoice_total") @db.Decimal(12, 2)

  /// "This is not the total of this invoice" -- partial allocations, invoices
  /// spanning several tickets. Short, human-read, and explicitly NOT arithmetic.
  vendorInvoiceAllocationNote String? @map("vendor_invoice_allocation_note")

  /// Long free-text passed to the billing card, e.g. "lines 1, 3, 5 from the
  /// DFE invoice are billable to items 1-4 on this ticket".
  ///
  /// HUMAN-READ ONLY, AND STRUCTURALLY SO. This column is deliberately absent
  /// from `ShopBillingItem` -- the projection the billing derivation is handed
  /// -- so `buildShopBillingLines` cannot read it even if a future author wants
  /// to. Someone will eventually want to scrape dollar amounts out of this
  /// field; the answer has to be "the code cannot see it", not "please don't".
  /// Amounts come from vendorInvoiceTotal, full stop.
  vendorBillingNotes String? @map("vendor_billing_notes")

  // ── WI-05: per-unit soft close ──────────────────────────────────────────
  //
  // PER-UNIT, not per-work-order, because this repo already bills per unit: a
  // unit settles when IT reaches a terminal-billable state, not when the parent
  // WO closes. A WO-level close would have had to reverse that.
  //
  // softClosedAt is stamped the first time a unit reaches shop_complete /
  // returned / condemned -- exactly BILLABLE_STATES, so "settled" and "closed"
  // cannot drift apart. Only the FIRST such transition stamps it: a unit that
  // goes ready-for-pickup and is collected three days later closed when the
  // work finished, not when the customer turned up.
  //
  // hardClosesAt is softClosedAt + 48 WALL-CLOCK hours. Not business hours --
  // a Friday 16:00 close is hard before Monday, deliberately.
  softClosedAt DateTime? @map("soft_closed_at")
  hardClosesAt DateTime? @map("hard_closes_at")
  /// Who closed it. They and a supervisor may edit during the soft window.
  closedById   String?   @map("closed_by_id")

  /// Platform-admin unlock after hard close: a fresh 48h, reason required.
  /// Kept as a count + last-reason rather than a boolean so a unit that has
  /// been re-opened four times says so.
  unlockedAt   DateTime? @map("unlocked_at")
  unlockedById String?   @map("unlocked_by_id")
  unlockReason String?   @map("unlock_reason")
  unlockCount  Int       @default(0) @map("unlock_count")

  /// Stamped when the unit's VaultPRO push has fired. The push is idempotent
  /// on its own, but "fires exactly once" is a requirement, so it is recorded
  /// rather than inferred.
  vaultPushedAt DateTime? @map("vault_pushed_at")

  /// WI-05 identity resolution, run AT CLOSE rather than at intake. Null while
  /// unresolved; 'matched' once a human confirmed this is the same physical
  /// unit as an existing record; 'created' when there was no candidate and a
  /// new record was minted silently.
  identityResolution   String?   @map("identity_resolution")
  identityResolvedAt   DateTime? @map("identity_resolved_at")
  identityResolvedById String?   @map("identity_resolved_by_id")

  // On-Hold reason (WI-02). Only ever set for the generic `on_hold` status —
  // the parts/approval/vendor holds derive their reason from status instead.
  // holdNote is the optional short free-text qualifier shown on card detail;
  // it is display-only and is never parsed for anything.
  holdReason ShopHoldReason? @map("hold_reason")
  holdNote   String?         @map("hold_note")

  // Per-unit billing ledger (Wave 2): a unit bills when IT reaches a
  // terminal-billable state, NOT when the parent WO closes. billedAt set = the
  // unit was swept onto a billing ticket; the idempotent "bill ready" sweep
  // skips units that already have billedAt. billedTicketId points at the
  // ServiceTicket the unit was swept onto (plain id reference / audit pointer —
  // intentionally not a Prisma FK relation, to avoid coupling to ServiceTicket).
  billedAt       DateTime? @map("billed_at")
  billedTicketId String?   @map("billed_ticket_id")

  // Parts used on this item (JSONB for flexibility). Kept as the "materials"
  // half of the billing chunk (catalog picks + MISC fallback).
  partsUsed Json? @map("parts_used") @db.JsonB

  // Per-unit billing chunk (structured close-out billing beyond raw parts).
  //   labor  : { hours, rate } — real billable time (replaces the faked
  //            defaultSellPrice×1 labor line when present)
  //   misc   : [{ description, amount }] — per-unit ad-hoc charges
  //   vendor : { cost, freight, markupPct, attachmentKey, attachmentName } —
  //            outside-vendor passthrough + the scanned vendor invoice (file
  //            key served via /api/files). Supersedes the legacy
  //            customData.vendorBilling shape when present.
  //   rollup : { enabled, rate, productId } — bill this unit as part of an
  //            "N units × rate" inspection/visual roll-up line instead of its
  //            own labor line.
  billing Json? @map("billing") @db.JsonB

  // SCBA parent reference: if this is a sub-component, link to parent item
  parentItemId String? @map("parent_item_id")

  customData Json?    @map("custom_data") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  workOrder            ShopWorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  site                 Site                    @relation(fields: [siteId], references: [id])
  serializedEquipment  SerializedEquipment?    @relation(fields: [serializedEquipmentId], references: [id])
  product              Product?                @relation(fields: [productId], references: [id])
  diagnosedBy          User?                   @relation("ShopDiagnosedBy", fields: [diagnosedById], references: [id])
  assignedTo           User?                   @relation("ShopAssignedTo", fields: [assignedToId], references: [id])
  qcTestedBy           User?                   @relation("ShopQcTestedBy", fields: [qcTestedById], references: [id])
  parentItem           ShopWorkOrderItem?      @relation("ScbaComponents", fields: [parentItemId], references: [id])
  childComponents      ShopWorkOrderItem[]     @relation("ScbaComponents")
  statusHistory        ShopItemStatusLog[]
  printJobs            PrintJob[]
  equipmentInspections EquipmentInspection[]
  transferItems        ShopTransferEventItem[]
  attachments          Attachment[]
  qaResults            ShopQaUnitResult[]

  @@map("shop_work_order_items")
}

model ShopItemStatusLog {
  id          String          @id @default(uuid())
  itemId      String          @map("item_id")
  fromStatus  ShopItemStatus? @map("from_status")
  toStatus    ShopItemStatus  @map("to_status")
  changedById String?         @map("changed_by_id")
  notes       String?
  location    String? // "Basin Shop", "Sent to MSA", etc.
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  item      ShopWorkOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changedBy User?             @relation("ShopStatusChanger", fields: [changedById], references: [id])

  @@map("shop_item_status_log")
}

// ============================================================
// CONTACT LOG (Division 6 batch, WI-10)
// ============================================================
//
// "Called DFE about this job, ETA 9/1." One place for that, whoever it was said
// to.
//
// THE SPEC SAID "GENERALIZE THE EXISTING TABLE". There was no table. The
// customer-contact log was a `contact_log` JSONB array on ShopWorkOrder, and it
// was never scoped to Ready For Pickup either -- only the CARD was, by a
// `status === 'complete'` check in the page. So this builds the table the spec
// assumed existed and migrates the JSON into it.
//
// WHY A TABLE AT ALL, rather than a second JSONB array with a party field: an
// array on the parent row cannot be queried across work orders, and the
// follow-up widget's entire job is "show me every job whose ETA has passed".
// That question is unanswerable against JSONB scattered over 135 rows without
// scanning all of them. It is also why `followUpAt` is a real column and not a
// key inside a blob.
//
// APPEND-ONLY IS ENFORCED BY THE DATABASE, not by the routes. See the trigger
// in the 20260831190000 migration: once written, an entry's content columns
// cannot change. A supervisor "delete" is a SOFT delete -- the row stays, marked
// with who removed it and why. A log that can have rows physically removed is
// not append-only, and "delete with a logged reason" that loses the thing being
// deleted keeps the reason and throws away the evidence.

enum ContactParty {
  customer
  vendor
}

enum ContactMethod {
  call
  email
  text
  in_person
  other
}

model ShopContactLogEntry {
  id          String @id @default(uuid())
  workOrderId String @map("work_order_id")

  /// Who was spoken to. The discriminator that makes one table serve both the
  /// "chasing the customer for pickup" and "chasing the vendor for an ETA"
  /// cards without either becoming a special case.
  party  ContactParty
  method ContactMethod

  note        String
  contactedAt DateTime @map("contacted_at")

  /// Optional ETA / next follow-up. A real column because the whole point of
  /// the supervisor widget is to ask "whose ETA has passed" ACROSS work orders.
  followUpAt DateTime? @map("follow_up_at")

  entererById String? @map("entered_by_id")
  /// Snapshotted name. The entry has to stay readable after the account that
  /// wrote it is deactivated or renamed -- this is a log, not a join.
  enteredByName String? @map("entered_by_name")

  /// Soft delete. Supervisors only, reason required, both recorded.
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id")
  deleteReason String?   @map("delete_reason")

  createdAt DateTime @default(now()) @map("created_at")

  workOrder ShopWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  enteredBy User?         @relation("ShopContactEnteredBy", fields: [entererById], references: [id])
  deletedBy User?         @relation("ShopContactDeletedBy", fields: [deletedById], references: [id])

  @@index([workOrderId])
  /// The follow-up widget's query: open ETAs, oldest first, across every WO.
  @@index([followUpAt])
  @@map("shop_contact_log_entries")
}

// ============================================================
// BATCH QA (Division 6 batch, WI-06)
// ============================================================
//
// QA a selection of units in one action, then handle the exceptions one at a
// time. The record shape is deliberately split, because the two consumers want
// opposite things:
//
//   ServicePRO wants it NORMALIZED. The batch checklist lives in exactly one
//   row, so correcting a mis-entered batch is one UPDATE. The alternative --
//   N copies -- is N updates that can partially fail and leave four units
//   claiming four different versions of the same inspection.
//
//   VaultPRO wants it DENORMALIZED. A ledger record is immutable and has to
//   stand alone forever, with no dependency on an SP row somebody reorganizes
//   in three years. So at hard close each unit's result is flattened into a
//   complete, self-contained snapshot with the checklist and batch context
//   inlined, and THAT is what gets pushed.
//
// The two are not in tension because they happen at different times, and WI-05
// already drew the line between them: normalized while the record is still
// correctable, denormalized at the moment it stops being.

enum ShopQaOutcome {
  pass
  fail
}

/// The batch header -- who ran the QA, when, against which checklist, and what
/// the shared result was. ONE row per batch action, however many units.
model ShopQaEvent {
  id          String @id @default(uuid())
  workOrderId String @map("work_order_id")

  /// Every unit in a batch shares a category, enforced at the route: a
  /// checklist is category-specific, and passing an SCBA against the fire-
  /// extinguisher list is not a batch, it is a mistake with four victims.
  category EquipmentInspectionCategory

  /// Fingerprint of the catalog checkpoints this batch ran against
  /// (services/inspectionChecklist.ts `checklistVersion`). Derived from the
  /// content, so it cannot drift from what was actually on screen.
  checklistVersion String @map("checklist_version")

  /// The shared checklist result: { checkpointKey: boolean }. THE one row that
  /// a correction updates.
  checklistResults Json @default("{}") @map("checklist_results") @db.JsonB

  /// Actions the batch attests were performed. Drives which checkpoints are
  /// required (`appliesToActions`), same as a per-unit inspection.
  serviceActions Json @default("[]") @map("service_actions") @db.JsonB

  notes String?

  performedById String?  @map("performed_by_id")
  performedAt   DateTime @map("performed_at")

  /// Set when the batch was corrected inside the units' soft-close window.
  correctedAt   DateTime? @map("corrected_at")
  correctedById String?   @map("corrected_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workOrder   ShopWorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  performedBy User?              @relation("ShopQaPerformedBy", fields: [performedById], references: [id])
  correctedBy User?              @relation("ShopQaCorrectedBy", fields: [correctedById], references: [id])
  results     ShopQaUnitResult[]

  @@index([workOrderId])
  @@map("shop_qa_events")
}

/// One unit's outcome within a batch. Carries only what differs per unit --
/// the shared checklist stays on the event and is read through, never copied,
/// until the snapshot is taken.
model ShopQaUnitResult {
  id        String @id @default(uuid())
  qaEventId String @map("qa_event_id")
  itemId    String @map("item_id")

  outcome ShopQaOutcome

  /// Per-unit deviations from the batch checklist: { checkpointKey: boolean }.
  /// Empty for a plain batch pass; populated when a unit is QA'd individually
  /// or when one checkpoint went differently on one unit.
  checklistOverrides Json @default("{}") @map("checklist_overrides") @db.JsonB

  /// Checkpoint keys this unit failed -- the per-unit failure detail WI-06 asks
  /// for. Stored explicitly rather than derived so the reason a unit bounced is
  /// still legible after the catalog changes.
  failedKeys Json @default("[]") @map("failed_keys") @db.JsonB

  notes String?

  /// The locked EquipmentInspection this result materialized into at hard
  /// close. Null while the unit is still inside its soft window -- the QA
  /// result IS the artifact until then. Null forever if the unit already had
  /// its own locked ledger inspection (we do not write a second ledger event
  /// for one unit's service).
  inspectionId String? @unique @map("inspection_id")

  /// The denormalized, self-contained record: checklist, labels, batch context,
  /// actor, timestamps -- everything needed to read this QA in isolation.
  /// Written once at hard close and never updated; its presence is what makes
  /// the batch uncorrectable.
  vaultSnapshot   Json?     @map("vault_snapshot") @db.JsonB
  vaultSnapshotAt DateTime? @map("vault_snapshot_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  qaEvent    ShopQaEvent          @relation(fields: [qaEventId], references: [id], onDelete: Cascade)
  item       ShopWorkOrderItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inspection EquipmentInspection? @relation(fields: [inspectionId], references: [id])

  @@unique([qaEventId, itemId])
  @@index([itemId])
  @@map("shop_qa_unit_results")
}

// ============================================================
// LABEL PRINTING (Multi-Site Expansion Phase 2)
// ============================================================
//
// Networked Zebra ZD411d label printers, one+ per Site intake area. Every
// print operation queues through PrintJob and is drained by a background
// worker that opens a raw TCP socket to the printer's :9100 and writes ZPL II.

enum PrinterDriver {
  ZEBRA_ZPL
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  SUCCEEDED
  FAILED
}

model Printer {
  id                String        @id @default(uuid())
  name              String
  siteId            String        @map("site_id")
  ipAddress         String        @map("ip_address")
  port              Int           @default(9100)
  driver            PrinterDriver @default(ZEBRA_ZPL)
  labelWidthMm      Int           @map("label_width_mm")
  labelHeightMm     Int           @map("label_height_mm")
  defaultForStation String?       @map("default_for_station") // "intake" | "qc" | null
  active            Boolean       @default(true)
  lastSeenAt        DateTime?     @map("last_seen_at")
  lastError         String?       @map("last_error")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  site      Site       @relation(fields: [siteId], references: [id])
  printJobs PrintJob[]

  @@map("printers")
}

model LabelTemplate {
  id        String        @id @default(uuid())
  name      String        @unique
  driver    PrinterDriver @default(ZEBRA_ZPL)
  appliesTo String        @default("shop_work_order") @map("applies_to")
  template  String        @db.Text // ZPL with ${variable} placeholders
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  printJobs PrintJob[]

  @@map("label_templates")
}

model PrintJob {
  id                  String         @id @default(uuid())
  shopWorkOrderId     String         @map("shop_work_order_id")
  shopWorkOrderItemId String?        @map("shop_work_order_item_id")
  printerId           String         @map("printer_id")
  templateId          String         @map("template_id")
  status              PrintJobStatus @default(QUEUED)
  attempts            Int            @default(0)
  copies              Int            @default(1)
  triggeredByUserId   String?        @map("triggered_by_user_id")
  reason              String // "initial" | "reprint" | "transfer_arrival"
  reprintReason       String?        @map("reprint_reason") // "damaged" | "brakleen" | "lost" | "other"
  errorMessage        String?        @map("error_message")
  nextAttemptAt       DateTime?      @map("next_attempt_at") // backoff gate for the worker
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at") // also marks claim time for stale-PRINTING reclaim
  completedAt         DateTime?      @map("completed_at")

  shopWorkOrder     ShopWorkOrder      @relation(fields: [shopWorkOrderId], references: [id])
  shopWorkOrderItem ShopWorkOrderItem? @relation(fields: [shopWorkOrderItemId], references: [id])
  printer           Printer            @relation(fields: [printerId], references: [id])
  template          LabelTemplate      @relation(fields: [templateId], references: [id])
  triggeredBy       User?              @relation("PrintJobTrigger", fields: [triggeredByUserId], references: [id])

  @@index([status])
  @@map("print_jobs")
}

// ============================================================
// KIOSKS + BOARD CONFIG (Multi-Site Expansion Phase 3)
// ============================================================
//
// A Kiosk is a wall-mounted display or touchscreen bolted to a specific
// Site. It has its own provisioned identity (slug + apiToken) — no user
// logs in on a kiosk. BOARD/STATION kiosks are read-only; CLAIM kiosks
// (Phase 4) are interactive.

enum KioskRole {
  BOARD // full read-only kanban -- CUSTOMER work only
  INHOUSE // full read-only kanban -- Basin's own in-house work only
  STATION // single-column read-only display
  CLAIM // interactive touch-claim at receiving
  TRAINING // classroom sign-in board / signage (today's classes + QR)
  // Rentals kanban, split the same way the shop board is: by what the device is
  // for, not by what it can technically render. A dispatcher's wall wants jobs
  // Basin delivers; the counter wants gear customers carry out themselves. Same
  // three columns either way -- the split is RentalAgreement.pickup_type.
  RENTALS_DISPATCH // rentals kanban -- pickup_type = dispatch
  RENTALS_WALKIN // rentals kanban -- pickup_type = walk_in
}

model Kiosk {
  id                String    @id @default(uuid())
  slug              String    @unique // "wil-receiving", "wil-board"
  displayName       String    @map("display_name")
  siteId            String    @map("site_id")
  role              KioskRole
  stationFilter     String?   @map("station_filter") // STATION role: a board column key
  // CLAIM role only: when set (>0), a signed-in intake session on this device
  // auto-logs-out after this many idle minutes so the next intake signs in fresh.
  // The claim board itself stays open on the device token. Null/0 = no auto-logout.
  idleLogoutMinutes Int?      @map("idle_logout_minutes")
  active            Boolean   @default(true)
  apiToken          String    @unique @map("api_token") // device auth token
  lastSeenAt        DateTime? @map("last_seen_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id])

  @@map("kiosks")
}

/// Incoming webhook URLs are secrets; never include them in API responses or audit logs.
model WebhookNotification {
  channel   String   @id
  enabled   Boolean  @default(true)
  url       String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("webhook_notifications")
}

model WorkPointVerificationConfig {
  id         String @id @default("default")
  expiryDays Int    @default(0) @map("expiry_days")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("work_point_verification_config")
}

// Singleton row — admin-tunable shop-board aging thresholds (hours in status
// before a card flags as aging). Keyed by ShopItemStatus.
model BoardConfig {
  id              String   @id @default(uuid())
  agingThresholds Json     @map("aging_thresholds")
  // Per-display-column color overrides for the shop board, keyed by display
  // column (received/in_service/on_hold/qa_testing/ready_pickup/...). Value is
  // a "#rrggbb" hex, or null to force the neutral dark default. Absent keys
  // fall back to the client's built-in defaults. null column = not yet themed.
  columnColors    Json?    @map("column_colors")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("board_config")
}

// Admin-editable RBAC overrides (singleton row). `matrix` is a JSON object
// keyed by capability → array of roles allowed to use it. It stores ONLY
// overrides: capabilities absent from the matrix fall back to the code-defined
// DEFAULT_PERMISSIONS in server/src/services/permissions.ts. The effective
// permission set = defaults merged with these overrides. platform_admin is
// always all-powerful regardless of what's stored here.
model PermissionConfig {
  id        String   @id @default(uuid())
  matrix    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permission_config")
}

// ============================================================
// SHOP TRANSFER EVENT (Wave 2 — multi-shop chain log)
// ============================================================
// Append-only log of shop-to-shop transfers between Basin Sites. The WO's
// birth state at its intake Site is NOT a transfer event; the customer-side
// release is captured by ShopWorkOrder.returnedDate + pickupSignature.
// One row per shop-to-shop hop. Append-only by convention (no PATCH/DELETE).

model ShopTransferEvent {
  id              String    @id @default(uuid())
  workOrderId     String    @map("work_order_id")
  fromSiteId      String    @map("from_site_id")
  toSiteId        String    @map("to_site_id")
  transferredById String?   @map("transferred_by_id") // who initiated (logged-in user)
  // Who physically transported the units. Distinct from transferredById — the
  // initiator clicks "Initiate" in the app; the transporter may be any active
  // employee (driver, another tech). Free-choice from the active-user list.
  transportedById String?   @map("transported_by_id")
  transferredAt   DateTime  @default(now()) @map("transferred_at") // initiated at
  // Two-phase: receivedAt null = still in transit. Set when the destination
  // confirms arrival; that's also when the WO's items move to toSite.
  receivedAt      DateTime? @map("received_at")
  receivedById    String?   @map("received_by_id")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  workOrder     ShopWorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromSite      Site                    @relation("ShopTransferFromSite", fields: [fromSiteId], references: [id])
  toSite        Site                    @relation("ShopTransferToSite", fields: [toSiteId], references: [id])
  transferredBy User?                   @relation("ShopTransferEventBy", fields: [transferredById], references: [id])
  transportedBy User?                   @relation("ShopTransferTransportedBy", fields: [transportedById], references: [id])
  receivedBy    User?                   @relation("ShopTransferReceivedBy", fields: [receivedById], references: [id])
  items         ShopTransferEventItem[]

  @@index([workOrderId])
  @@index([receivedAt])
  @@map("shop_transfer_events")
}

// Which items a transfer event moves. Absent for legacy whole-WO events
// (backfilled at migration time). A partial transfer links only the chosen
// items; an item with a row on an unreceived event is "in transit".
model ShopTransferEventItem {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  itemId  String @map("item_id")

  event ShopTransferEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item  ShopWorkOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([eventId, itemId])
  @@index([itemId])
  @@map("shop_transfer_event_items")
}

// ---------------------------------------------------------------------------
// SSO Role Mappings — maps Google Workspace groups to Sundog roles
// ---------------------------------------------------------------------------

model GoogleRoleMapping {
  id               String   @id @default(uuid())
  googleGroupEmail String   @unique @map("google_group_email")
  sundogRole       UserRole @map("sundog_role")
  priority         Int      @default(0) // higher = takes precedence when user is in multiple groups
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("google_role_mappings")
}

// ============================================================
// QB PRICE LEVELS — Wave 5 Slice 5B
// ============================================================
// Per-customer fixed-price agreements pulled from QB Desktop. QBWC qbXML
// supports PriceLevelQueryRq (unlike QB Online), so the Price Level
// "Per Item" lists ride along with the existing item/customer sync layer.
//
// Pull is read-only. Apply path (use this price during invoice generation
// when company + product match) is part of the billing-rules engine — see
// services/billingRules.ts. Storage shape mirrors QB's:
//
//   PriceLevel ──< PriceLevelItem
//   each PriceLevel can target a specific Customer (via qbCustomerListId)
//   each item carries a per-product override (custom price OR % off)
//
// We store qbCustomerListId as a string so a sync can land before the
// customer is on file in Sundog without erroring; the apply-time
// resolver looks the customer up.

model PriceLevel {
  id               String    @id @default(uuid())
  qbListId         String    @unique @map("qb_list_id")
  name             String
  isActive         Boolean   @default(true) @map("is_active")
  // The customer this level is assigned to (PriceLevelPerItemRet on QB
  // side). NULL = "global" price level (rare for our QB setup but
  // possible). qbCustomerListId is the QB ListID; we don't FK to
  // companies because the pull may land before the customer sync.
  qbCustomerListId String?   @map("qb_customer_list_id")
  qbCustomerName   String?   @map("qb_customer_name")
  // Snapshot of QB's TimeModified — drives the "what changed since last
  // pull" filter on subsequent syncs.
  qbTimeModified   DateTime? @map("qb_time_modified")
  lastSyncedAt     DateTime? @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  items     PriceLevelItem[]
  // Wave 5 5C — Sundog-side admin assignment (option B). Many companies
  // can share one level (e.g. multiple sub-operators all on a "Tier 2"
  // price list).
  companies Company[]

  @@index([qbCustomerListId], map: "price_levels_customer_idx")
  @@map("price_levels")
}

model PriceLevelItem {
  id             String   @id @default(uuid())
  priceLevelId   String   @map("price_level_id")
  // QB item identifier. Same lookup-on-apply pattern as customer above —
  // a PL pull may land before the next item sync, so we don't FK.
  qbItemListId   String   @map("qb_item_list_id")
  qbItemFullName String?  @map("qb_item_full_name")
  // QB exposes either a fixed custom price OR a percentage adjustment
  // (positive = markup, negative = discount). Both nullable; one will
  // be set per row.
  customPrice    Decimal? @map("custom_price") @db.Decimal(12, 2)
  adjustPercent  Decimal? @map("adjust_percent") @db.Decimal(6, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Cascade)

  @@unique([priceLevelId, qbItemListId], map: "price_level_items_unique")
  @@map("price_level_items")
}

// ============================================================
// JOB RUNS — last-run + status tracking for scheduled background jobs
// (Wave 4 watcher layer foundation; surfaces on the Ops Dashboard).
// ============================================================

enum JobRunStatus {
  running
  success
  error
  skipped // lock held by another runner — ran nothing
}

model JobRun {
  id           String       @id @default(uuid())
  jobName      String       @map("job_name")
  startedAt    DateTime     @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  status       JobRunStatus
  durationMs   Int?         @map("duration_ms")
  errorMessage String?      @map("error_message")

  @@index([jobName, startedAt(sort: Desc)], map: "job_runs_name_started_idx")
    @@index([startedAt], map: "job_runs_started_idx")
  @@map("job_runs")
}

/// In-app bug reports / feature requests submitted from the sidebar widget.
/// Persisted so they survive a mail outage and show on the Ops dashboard.
model BugReport {
  id            String   @id @default(uuid())
  type          String   @default("bug") // 'bug' | 'feature'
  title         String
  description   String?  @db.Text
  reporterId    String?  @map("reporter_id")
  reporterName  String?  @map("reporter_name")
  reporterEmail String?  @map("reporter_email")
  reporterRole  String?  @map("reporter_role")
  route         String?
  context       Json?    @db.JsonB
  logs          Json?    @db.JsonB
  screenshotKey String?  @map("screenshot_key")
  emailed       Boolean  @default(false)
  status        String   @default("open") // 'open' | 'resolved'
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)], map: "bug_reports_status_created_idx")
  @@map("bug_reports")
}

// ============================================================
// CLASSPRO — training scheduling & course-definition module
// ============================================================
// Bounded module (ADR-0002): all tables carry the cp_ prefix and never
// FK into ticket/invoice internals. The course catalog below is the
// source of truth for course definitions; Sundog caches titles/details
// onto tickets and roster records (courseName stays the display label).

/// Training course catalog. Replaces the hardcoded client COURSE_TYPES
/// array and the static courseProductMap / blueLionClassMap tables —
/// those remain as bad-divorce fallbacks when a course is missing here.
model CpCourse {
  id   String @id @default(uuid())
  /// Stable slug, e.g. 'h2s_clear'. Matches the legacy COURSE_TYPES value.
  code String @unique
  /// Display label, e.g. 'H2S CLEAR'. Denormalized onto roster records
  /// as courseName, so treat renames as display-only (old records keep
  /// the label they were trained under).
  name String

  durationHours  Float? @map("duration_hours")
  validityMonths Int?   @map("validity_months")
  /// Default passing score (%); overridable per student at record time.
  passingScore   Int?   @map("passing_score")

  /// Governed VaultPRO (BlueLion) cert-type classCode. NULL = unmapped —
  /// the cert push parks the record (needs_attention) instead of guessing.
  /// Confirm against VaultPRO GET /cert-types before setting.
  vaultProClassCode String? @map("vaultpro_class_code")

  /// Instructor hands a card in class (pre-checks cardIssuedOnSite).
  cardsOnSite Boolean @default(false) @map("cards_on_site")

  /// QB billing item for invoice generation (Product.partNumber lookup).
  qbPartNumber String? @map("qb_part_number")

  /// Snapshotted onto records at record time.
  bookVersion String? @map("book_version")
  testVersion String? @map("test_version")

  /// Regulatory standard, e.g. 'OSHA 1910.146'.
  standard    String?
  description String?

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions CpScheduledSession[]

  @@map("cp_courses")
}

/// ClassPRO Tier-A training location — persisted, reusable, geocoded.
/// Tier-B (ad-hoc) locations are session metadata, not rows here; repeated
/// identical ad-hoc entries are the signal to promote one to Tier A.
model CpLocation {
  id        String  @id @default(uuid())
  name      String
  /// 'basin' (our shop/classroom) | 'client' (customer site) | 'other'
  type      String  @default("client")
  /// For client-type locations: which customer (shared Company reference).
  companyId String? @map("company_id")

  address String?
  city    String?
  state   String?
  zip     String?

  /// Geocoded on save when GOOGLE_MAPS_API_KEY is configured; manual entry
  /// works without it (bad-divorce).
  lat Float?
  lng Float?

  /// Cached one-way drive time from the shop (CLASSPRO_SHOP_ORIGIN).
  /// Sessions inherit this as their default travel buffer; overridable there.
  driveTimeFromShopMin Int? @map("drive_time_from_shop_min")

  notes    String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company?             @relation("CpLocationCompany", fields: [companyId], references: [id])
  sessions CpScheduledSession[]

  @@index([companyId])
  @@map("cp_locations")
}

/// A staff member who teaches classes. References the shared User row —
/// this is scheduling metadata, not a second person table.
model CpTrainer {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                      @relation(fields: [userId], references: [id])
  unavailability CpTrainerUnavailability[]
  sessions       CpScheduledSession[]

  @@map("cp_trainers")
}

/// Per-trainer per-date unavailability (PTO, other duty). "Currently
/// available" is DERIVED server-side (active, no row for the date, and —
/// once sessions exist — no session+travel-buffer overlap); never stored.
model CpTrainerUnavailability {
  id        String   @id @default(uuid())
  trainerId String   @map("trainer_id")
  date      DateTime @db.Date
  reason    String?

  createdAt DateTime @default(now()) @map("created_at")

  trainer CpTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, date])
  @@map("cp_trainer_unavailability")
}

/// ClassPRO scheduled session — the calendar unit. One class, one trainer,
/// one place, one date. Pushed ONCE to Sundog as a draft training ticket in
/// wave 4 ("make the class"); ticketId is display/idempotency metadata only,
/// never a hard FK (Sundog owns the ticket from birth).
model CpScheduledSession {
  id        String  @id @default(uuid())
  courseId  String  @map("course_id")
  /// Nullable so a slot can be held before a trainer is assigned; the
  /// calendar renders unassigned sessions distinctly.
  trainerId String? @map("trainer_id")

  /// Tier-A location (reusable). Mutually exclusive with the ad-hoc fields.
  locationId   String? @map("location_id")
  /// Tier-B ad-hoc location: session metadata, deliberately NOT a location
  /// row. Geocoded once on save; repeated identical entries are the signal
  /// to promote to Tier A.
  adHocAddress String? @map("ad_hoc_address")
  adHocLat     Float?  @map("ad_hoc_lat")
  adHocLng     Float?  @map("ad_hoc_lng")

  date      DateTime @db.Date
  /// "HH:MM" 24h, shop-local. Strings render directly and avoid tz math.
  startTime String   @map("start_time")
  endTime   String   @map("end_time")

  deliveryMode String @default("in_house") @map("delivery_mode") // 'in_house' | 'on_site'
  capacity     Int?

  /// Travel bands (minutes) rendered around the session on the calendar.
  /// Inherited from the location's cached drive-time-from-shop (or the
  /// ad-hoc geocode) on save; overridable per session.
  travelBeforeMin Int @default(0) @map("travel_before_min")
  travelAfterMin  Int @default(0) @map("travel_after_min")

  status   String  @default("scheduled") // 'scheduled' | 'cancelled' | 'pushed' | 'completed'
  /// Set when "make the class" creates the draft ticket (wave 4).
  ticketId String? @map("ticket_id")

  /// Booking customer for the ticket push (defaults from the Tier-A
  /// location's company in the UI). The ticket needs exactly one even when
  /// the roster spans employers — per-employer invoice split happens at
  /// billing off the roster's employerCompanyId.
  companyId String? @map("company_id")

  /// Google Calendar event id on the shared Training calendar (gcalSync).
  /// Makes push/update/cancel idempotent; null = not (yet) synced.
  gcalEventId String? @map("gcal_event_id")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course        CpCourse                @relation(fields: [courseId], references: [id])
  trainer       CpTrainer?              @relation(fields: [trainerId], references: [id])
  location      CpLocation?             @relation(fields: [locationId], references: [id])
  company       Company?                @relation("CpSessionCompany", fields: [companyId], references: [id])
  registrations CpSessionRegistration[]

  @@index([date])
  @@index([trainerId, date])
  @@map("cp_scheduled_sessions")
}

/// Pre-registered student on a scheduled session (wave 4). Copied onto the
/// draft training ticket as TrainingRosterRecords by the "make the class"
/// push; after push the ticket roster is the source of truth and these rows
/// are history. employerCompanyId is set silently by the employer matcher
/// (alias or exact name hit) or explicitly via the picker.
model CpSessionRegistration {
  id        String @id @default(uuid())
  sessionId String @map("session_id")

  studentName       String  @map("student_name")
  employerName      String? @map("employer_name")
  employerCompanyId String? @map("employer_company_id")

  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session         CpScheduledSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employerCompany Company?           @relation("CpRegistrationEmployer", fields: [employerCompanyId], references: [id])

  @@index([sessionId])
  @@map("cp_session_registrations")
}

// ============================================================
// NOVARA FLEX — equipment existence + compliance sync
// ============================================================
// One-way pull: Novara → ServicePRO. Nothing is ever pushed back.
//
// Novara's shape is (equipment type → equipment → schedules). Their
// `equipments.list` REQUIRES an equipmentType_id, so a full pull is
// `equipmenttypes.list` followed by one call per type. Their rate limit is
// ~80 req/min for the whole customer account, shared across every token —
// which is also why the sync never calls `inspections.list` (one call per
// UNIT would blow the budget on the first few hundred units). Compliance
// comes off the `status` + `schedules` already embedded in equipments.list.

/// Novara equipment type → SP Product. This is the gate on auto-create:
/// the sync creates a SerializedEquipment row for an unseen Novara serial
/// ONLY when its type has a productId here and autoCreate is on. Types with
/// no product are still recorded (discovered on every run) so the admin page
/// can show "47 units waiting on a mapping" instead of silently dropping them.
model NovaraEquipmentTypeMap {
  id              String @id @default(uuid())
  novaraTypeId    String @unique @map("novara_type_id")
  novaraTypeTitle String @map("novara_type_title")

  /// null = unmapped. Units of this type are skipped and logged as issues.
  productId String? @map("product_id")
  /// Stamped on rows this mapping creates. Novara doesn't model ownership,
  /// so it has to be declared per type.
  ownership EquipmentOwnership @default(basin_safety)
  /// Off = update units we already have, but never create new ones.
  autoCreate  Boolean @default(true) @map("auto_create")
  /// Off = skip this type entirely (types tracked in Novara that SP doesn't care about).
  syncEnabled Boolean @default(true) @map("sync_enabled")

  /// Refreshed each run — how many units Novara returned for this type, and when.
  equipmentCount Int       @default(0) @map("equipment_count")
  lastSeenAt     DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  schedules NovaraScheduleMap[]

  @@map("novara_equipment_type_maps")
}

/// Novara inspection schedule → an SP due-date column.
///
/// Novara names its schedules freely ("Monthly Inspection", "Annual
/// Inspection", "Calibration"), so there is no safe hardcoded rule for which
/// one feeds SP's calibrationDueDate vs bumpTestDueDate. Discovered schedules
/// land here with targetField null (mirror only — the novara_* columns on the
/// unit are still maintained); an admin points the ones that matter at a real
/// SP column, and from then on the sync writes that column directly.
model NovaraScheduleMap {
  id                 String  @id @default(uuid())
  novaraTypeId       String  @map("novara_type_id")
  novaraScheduleId   String  @unique @map("novara_schedule_id")
  novaraScheduleName String? @map("novara_schedule_name")

  /// 'calibrationDueDate' | 'bumpTestDueDate' | null. Validated at the API
  /// layer against SP_DATE_TARGETS in routes/novara.ts — deliberately not a
  /// Prisma enum, since the set grows whenever SP adds a due-date column.
  targetField String? @map("target_field")

  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  type NovaraEquipmentTypeMap @relation(fields: [novaraTypeId], references: [novaraTypeId], onDelete: Cascade)

  @@index([novaraTypeId])
  @@map("novara_schedule_maps")
}

/// The review queue: one row per Novara unit the sync could not land.
///
/// Keyed on the Novara equipment id so a run re-touches (rather than
/// duplicates) an issue it already knows about. `resolvedAt` is stamped by the
/// next run that succeeds in landing the unit — the queue self-drains once the
/// admin adds the missing mapping, no manual dismissal needed.
///
/// reason ∈ 'unmapped_type'   — type has no productId
///          'auto_create_off' — type is mapped but autoCreate is off
///          'missing_serial'  — Novara record has no serial number to key on
///          'serial_conflict' — SP already has that serial under a DIFFERENT
///                              Novara id (two Novara records, one SP unit)
model NovaraSyncIssue {
  id                String  @id @default(uuid())
  novaraEquipmentId String  @unique @map("novara_equipment_id")
  novaraTypeId      String  @map("novara_type_id")
  novaraTypeTitle   String? @map("novara_type_title")
  serialNumber      String? @map("serial_number")
  novaraTitle       String? @map("novara_title")

  reason String
  detail String?

  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @map("last_seen_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([reason])
  @@index([resolvedAt])
  @@map("novara_sync_issues")
}

/// Company presentation settings; the uploaded logo lives in the FileStore.
model BrandingConfig {
  id          String   @id @default("singleton")
  companyName String   @default("Basin Safety") @map("company_name")
  logoKey     String?  @map("logo_key")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("branding_config")
}

/// Singleton holding the last Novara run's outcome for the admin page.
model NovaraSyncState {
  id          String    @id @default("singleton")
  lastRunAt   DateTime? @map("last_run_at")
  lastSummary Json?     @map("last_summary") @db.JsonB
  lastError   String?   @map("last_error")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("novara_sync_state")
}
