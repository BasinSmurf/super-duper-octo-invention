model Field {
  id        String   @id @default(uuid())
  name      String
  county    String?
  state     String   @default("ND")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pads             Pad[]
  wells            Well[]
  facilities       Facility[]
  serviceTickets   ServiceTicket[]
  rentalAgreements RentalAgreement[]
  billingGroups    BillingGroup[]

  @@map("fields")
}

enum PadAssetCategory {
  site
  // Floating: mobile, billed per-job to whoever contracted it, never tied to
  // one operator — see the FLOATING_ASSET_CATEGORIES allowlist in
  // locations.ts, which is what actually grants the cross-operator/field
  // dedup search bypass. Adding a value here does NOT get that behavior for
  // free; it must be added to that allowlist too.
  // rig/truck retired — rigs are now the thin standalone MobileAsset model,
  // trucks are free text captured directly on Air Fill tickets. Neither is
  // ever a Well/Pad row again.
  other_mobile
  // Fixed: a real place, but never a DMR wellbore, so it'll never get a DMR
  // match — same-operator/same-field dedup already works fine for these,
  // this just lets the pending-review queue label them instead of leaving
  // them looking unresolved.
  gas_plant
  tank_battery
  compressor_station
  swd_facility
  office
  shop
}

// Thin, standalone, operator-agnostic named assets — deliberately NOT a
// Well/Pad (no legal location, no DMR matching, no API number, no operator
// scoping). Two kinds today: `rig` backs the "Rig present" toggle on field
// service tickets; `air_trailer` is the re-homed identity for a customer's
// numbered breathing-air trailer, so its WorkPoint-based cylinder/hydro-test
// tracking has somewhere to live without pretending to be a wellsite.
enum MobileAssetKind {
  rig
  air_trailer
}

model MobileAsset {
  id        String          @id @default(uuid())
  name      String
  kind      MobileAssetKind
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  workPoints             WorkPoint[]
  serviceTicketsAsRigged ServiceTicket[] @relation("PresentRig")

  @@map("mobile_assets")
}

model Pad {
  id                String  @id @default(uuid())
  name              String
  fieldId           String? @map("field_id")
  currentOperatorId String? @map("current_operator_id")

  // Legal location
  section  Int?
  township Int?
  range    Int?

  // GPS & Access
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  county      String?
  directions  String?
  accessNotes String?  @map("access_notes")

  // Enverus charge-to: buyer-assigned FC facility code for this pad/battery.
  // Auto-flows onto the receipt's "Facility Property" ADF (well code wins, pad is fallback).
  facilityCode String? @map("facility_code")

  // Buyer cost code for this pad (COP "Cost Object", e.g. US00098794 "BECK PAD").
  // Stamped onto new invoices from its tickets (ticket > well > pad); seeded from
  // Enverus master data by scripts/import-enverus-cost-centers.cjs.
  costCenter String? @map("cost_center")

  // Buyer subcompany (Enverus site uuid) and remit-to department for work here; see
  // CustomerBillingProfile.buyerSiteSource / buyerDepartmentSource.
  buyerSiteUuid   String? @map("buyer_site_uuid")
  buyerDepartment String? @map("buyer_department")

  // Source tracking
  autoGenerated    Boolean @default(false) @map("auto_generated")
  manuallyVerified Boolean @default(false) @map("manually_verified")
  pendingReview    Boolean @default(false) @map("pending_review")

  // Native American reservation flag — gates customer "Tier 1" billing rules.
  tier1 Boolean @default(false) @map("tier_1")

  // Mobile/rented equipment (drilling rigs, service trucks) gets billed
  // per-job to whoever contracted it, not the operator of the site it's
  // currently parked at — so unlike a real pad it's never tied to one
  // operator. Flagging it here exempts it from the operator/field-scoped
  // dedup pool in the pending-request review so the SAME rig/truck record
  // gets reused across every operator it ever works for, instead of a new
  // one being created each time it shows up somewhere new.
  assetCategory PadAssetCategory @default(site) @map("asset_category")

  isActive   Boolean  @default(true) @map("is_active")
  customData Json?    @map("custom_data") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  field               Field?                @relation(fields: [fieldId], references: [id])
  currentOperator     Company?              @relation(fields: [currentOperatorId], references: [id])
  wells               Well[]
  facilities          Facility[]
  workPoints          WorkPoint[]
  operatorHistory     OperatorHistory[]
  serviceTickets      ServiceTicket[]
  rentalAgreements    RentalAgreement[]
  serializedEquipment SerializedEquipment[]
  routeStops          RouteStop[]
  shopWOsAsSource     ShopWorkOrder[]       @relation("ShopWOSourcePad")
  shopWOsAsReturn     ShopWorkOrder[]       @relation("ShopWOReturnPad")

  @@map("pads")
}

model Well {
  id                String  @id @default(uuid())
  padId             String? @map("pad_id")
  fieldId           String? @map("field_id")
  currentOperatorId String? @map("current_operator_id")

  // DMR Data
  dmrFileNumber Int?      @map("dmr_file_number")
  apiNumber     String?   @unique @map("api_number")
  apiShort      String?   @map("api_short")
  wellName      String?   @map("well_name")
  wellNameBase  String?   @map("well_name_base")
  totalDepth    Int?      @map("total_depth")
  spudDate      DateTime? @map("spud_date") @db.Date

  // Legal location
  quarterQuarter String? @map("quarter_quarter")
  section        Int?
  township       Int?
  range          Int?
  feetNs         Int?    @map("feet_ns")
  nsLine         String? @map("ns_line")
  feetEw         Int?    @map("feet_ew")
  ewLine         String? @map("ew_line")

  // GPS
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Classification
  wellType   WellType?   @map("well_type")
  wellStatus WellStatus? @map("well_status")
  county     String?

  // Same concept as Pad.assetCategory (shares the enum) — rigs/trucks that
  // got hand-added via AddWellModal's Manual Entry tab, once per operator
  // they ever worked for, since that path has zero dedup. Flagging one lets
  // it be found/reused across ALL operators instead of re-created every
  // time it shows up somewhere new. 'site' (the default) means a real
  // individual wellbore — the normal case.
  assetCategory PadAssetCategory @default(site) @map("asset_category")

  // Enverus charge-to: buyer-assigned FC facility code for this well.
  // Auto-flows onto the receipt's "Facility Property" ADF (preferred over the pad's code).
  facilityCode String? @map("facility_code")

  // Buyer cost code for this well (COP "Cost Object", e.g. US00098792). Preferred
  // over the pad's code; see Pad.costCenter.
  costCenter String? @map("cost_center")

  // Buyer subcompany / remit-to department; preferred over the pad's. See Pad.buyerSiteUuid.
  buyerSiteUuid   String? @map("buyer_site_uuid")
  buyerDepartment String? @map("buyer_department")

  // Native American reservation flag — same meaning and same 5% reservation
  // fee as Pad.tier1, but at well level. Needed because a pad-less well is
  // the majority case (2877 of 2886 wells), so a pad-only flag could never
  // fire for most reservation work. billingRules 5A fires on pad OR well; a
  // well under a Tier 1 pad doesn't need its own flag, and the fee is a
  // single per-invoice line either way, so both being true is harmless.
  tier1 Boolean @default(false) @map("tier_1")

  // Operational data
  hasSuppliedAir     Boolean @default(false) @map("has_supplied_air")
  hasAreaMonitors    Boolean @default(false) @map("has_area_monitors")
  isHighRisk         Boolean @default(false) @map("is_high_risk")
  riskNotes          String? @map("risk_notes")
  isActiveForService Boolean @default(true) @map("is_active_for_service")
  serviceNotes       String? @map("service_notes")

  // Import tracking
  dmrReferenceId String?   @map("dmr_reference_id")
  dmrImportDate  DateTime? @map("dmr_import_date") @db.Date
  dmrRawData     Json?     @map("dmr_raw_data") @db.JsonB

  pendingReview Boolean  @default(false) @map("pending_review")
  customData    Json?    @map("custom_data") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  pad                     Pad?                  @relation(fields: [padId], references: [id])
  field                   Field?                @relation(fields: [fieldId], references: [id])
  currentOperator         Company?              @relation(fields: [currentOperatorId], references: [id])
  workPoints              WorkPoint[]
  operatorHistory         OperatorHistory[]
  serviceTickets          ServiceTicket[]
  rentalAgreements        RentalAgreement[]
  serializedEquipment     SerializedEquipment[]
  fitTestRecords          FitTestRecord[]
  dmrReferences           DmrReferenceWell[]
  ticketLineItemOverrides TicketLineItem[]      @relation("WellOverride")
  routeStops              RouteStop[]

  @@map("wells")
}

model Facility {
  id                String       @id @default(uuid())
  name              String
  facilityType      FacilityType @map("facility_type")
  fieldId           String?      @map("field_id")
  padId             String?      @map("pad_id")
  currentOperatorId String?      @map("current_operator_id")

  // GPS & Access
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  county      String?
  section     Int?
  township    Int?
  range       Int?
  directions  String?
  accessNotes String?  @map("access_notes")

  // Service tracking
  hasSuppliedAir  Boolean  @default(false) @map("has_supplied_air")
  hasAreaMonitors Boolean  @default(false) @map("has_area_monitors")
  isActive        Boolean  @default(true) @map("is_active")
  serviceNotes    String?  @map("service_notes")
  pendingReview   Boolean  @default(false) @map("pending_review")
  customData      Json?    @map("custom_data") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  field               Field?                @relation(fields: [fieldId], references: [id])
  pad                 Pad?                  @relation(fields: [padId], references: [id])
  currentOperator     Company?              @relation(fields: [currentOperatorId], references: [id])
  workPoints          WorkPoint[]
  operatorHistory     OperatorHistory[]
  serviceTickets      ServiceTicket[]
  rentalAgreements    RentalAgreement[]
  serializedEquipment SerializedEquipment[]
  routeStops          RouteStop[]

  @@map("facilities")
}

model WorkPoint {
  id            String        @id @default(uuid())
  name          String
  verified      Boolean       @default(false)
  dateVerified  DateTime?     @map("date_verified")
  verificationChangedAt DateTime? @map("verification_changed_at")
  workPointType WorkPointType @map("work_point_type")

  // Polymorphic parent — belongs to exactly ONE
  wellId        String? @map("well_id")
  padId         String? @map("pad_id")
  facilityId    String? @map("facility_id")
  // Thin standalone assets (rigs, air trailers) — see MobileAsset. A trailer's
  // cylinder/hydro-test tracking hangs off here instead of pretending to be a
  // wellsite.
  mobileAssetId String? @map("mobile_asset_id")

  hasSuppliedAir Boolean @default(false) @map("has_supplied_air")
  hasAreaMonitor Boolean @default(false) @map("has_area_monitor")
  equipmentNotes String? @map("equipment_notes")

  // Air system serial tracking (from bacpac AirSystem table)
  reelSerialNumber  String? @map("reel_serial_number")
  standSerialNumber String? @map("stand_serial_number")
  airSystemType     String? @map("air_system_type")

  // Legacy import reference
  legacyAirSystemId String? @map("legacy_air_system_id")

  isActive   Boolean  @default(true) @map("is_active")
  customData Json?    @map("custom_data") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  well                    Well?                 @relation(fields: [wellId], references: [id])
  pad                     Pad?                  @relation(fields: [padId], references: [id])
  facility                Facility?             @relation(fields: [facilityId], references: [id])
  mobileAsset             MobileAsset?          @relation(fields: [mobileAssetId], references: [id])
  serviceTickets          ServiceTicket[]
  fitTestRecords          FitTestRecord[]
  ticketLineItemOverrides TicketLineItem[]      @relation("WorkPointOverride")
  airSystemInspections    AirSystemInspection[]

  @@map("work_points")
}

// ============================================================
// SERVICE ROUTES & CYCLE TRACKING
// ============================================================

model ServiceRoute {
  id             String   @id @default(uuid())
  name           String
  routeNumber    String?  @map("route_number")
  companyId      String   @map("company_id")
  area           String?
  description    String?
  estimatedMiles Decimal? @map("estimated_miles") @db.Decimal(8, 1)
  cycleMonths    Int      @default(6) @map("cycle_months")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")

  // Legacy import reference
  legacyRouteId String? @map("legacy_route_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company     Company           @relation(fields: [companyId], references: [id])
  stops       RouteStop[]
  cycles      RouteCycle[]
  assignments RouteAssignment[]

  @@unique([companyId, routeNumber])
  @@map("service_routes")
}

model RouteAssignment {
  id      String @id @default(uuid())
  routeId String @map("route_id")
  userId  String @map("user_id")

  // Whether this is the primary tech for the route
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  route ServiceRoute @relation(fields: [routeId], references: [id])
  user  User         @relation(fields: [userId], references: [id])

  @@unique([routeId, userId])
  @@map("route_assignments")
}

model RouteStop {
  id           String   @id @default(uuid())
  routeId      String   @map("route_id")
  padId        String?  @map("pad_id")
  wellId       String?  @map("well_id")
  facilityId   String?  @map("facility_id")
  stopIndex    Int      @map("stop_index")
  routeMileage Decimal? @map("route_mileage") @db.Decimal(8, 1)
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")

  // Per-stop billing overrides
  workOrderNumber String? @map("work_order_number")
  afeNumber       String? @map("afe_number")
  costCenter      String? @map("cost_center")
  salesTaxId      String? @map("sales_tax_id")

  // Display shorthand (tech's name for the location, e.g. "Smith 14-4")
  clientName String? @map("client_name")

  // Legacy import
  legacyLocationId String? @map("legacy_location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  route       ServiceRoute      @relation(fields: [routeId], references: [id])
  pad         Pad?              @relation(fields: [padId], references: [id])
  well        Well?             @relation(fields: [wellId], references: [id])
  facility    Facility?         @relation(fields: [facilityId], references: [id])
  cycleVisits RouteCycleVisit[]

  @@unique([routeId, stopIndex])
  @@map("route_stops")
}

model RouteCycle {
  id             String           @id @default(uuid())
  routeId        String           @map("route_id")
  cycleName      String?          @map("cycle_name")
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  status         RouteCycleStatus @default(active)
  totalStops     Int              @default(0) @map("total_stops")
  completedStops Int              @default(0) @map("completed_stops")
  assignedTechId String?          @map("assigned_tech_id")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  route        ServiceRoute      @relation(fields: [routeId], references: [id])
  assignedTech User?             @relation("CycleTech", fields: [assignedTechId], references: [id])
  visits       RouteCycleVisit[]

  @@map("route_cycles")
}

model RouteCycleVisit {
  id          String    @id @default(uuid())
  cycleId     String    @map("cycle_id")
  stopId      String    @map("stop_id")
  ticketId    String?   @map("ticket_id")
  visitedAt   DateTime? @map("visited_at")
  visitedById String?   @map("visited_by_id")
  skipped     Boolean   @default(false)
  skipReason  String?   @map("skip_reason")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  cycle     RouteCycle     @relation(fields: [cycleId], references: [id])
  stop      RouteStop      @relation(fields: [stopId], references: [id])
  ticket    ServiceTicket? @relation(fields: [ticketId], references: [id])
  visitedBy User?          @relation("VisitedBy", fields: [visitedById], references: [id])

  @@unique([cycleId, stopId])
  @@map("route_cycle_visits")
}

model OperatorHistory {
  id                 String                @id @default(uuid())
  wellId             String?               @map("well_id")
  padId              String?               @map("pad_id")
  facilityId         String?               @map("facility_id")
  previousOperatorId String                @map("previous_operator_id")
  newOperatorId      String                @map("new_operator_id")
  effectiveDate      DateTime              @map("effective_date") @db.Date
  source             OperatorHistorySource
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at")

  // Relations
  well             Well?     @relation(fields: [wellId], references: [id])
  pad              Pad?      @relation(fields: [padId], references: [id])
  facility         Facility? @relation(fields: [facilityId], references: [id])
  previousOperator Company   @relation("PrevOperator", fields: [previousOperatorId], references: [id])
  newOperator      Company   @relation("NewOperator", fields: [newOperatorId], references: [id])

  @@map("operator_history")
}

// ============================================================
// PRODUCTS, PARTS & INVENTORY
// ============================================================

model Product {
  id                       String          @id @default(uuid())
  partNumber               String          @unique @map("part_number")
  name                     String
  description              String?
  category                 ProductCategory
  // Free-form catalog grouping populated from the QB price-list work (e.g.
  // "shop", "shop > D6"). Drives the parts-picker category dropdown. Distinct
  // from `category` (the fixed equipment-type enum): this is a billing/pricing
  // facet, nullable, and holds whatever category strings AR curates in QB.
  catalogCategory          String?         @map("catalog_category")
  productType              ProductType     @map("product_type")
  // Parts-numbering facets derived from new-scheme 7-digit part numbers
  // (2-digit division 00–09 + 1-digit family + 1-digit subgroup + 3-digit
  // part; e.g. "0300002" = D3 Field Services labor). Null for legacy numbers.
  // These scope the catalog picker only — revenue attribution (QB Class)
  // stays on the ticket's division, never the part's.
  division                 Int?
  partFamily               Int?            @map("part_family")
  partSubgroup             Int?            @map("part_subgroup")
  unitOfMeasure            String?         @map("unit_of_measure")
  defaultSellPrice         Decimal?        @map("default_sell_price") @db.Decimal(12, 2)
  defaultRentalRateDaily   Decimal?        @map("default_rental_rate_daily") @db.Decimal(12, 2)
  defaultRentalRateWeekly  Decimal?        @map("default_rental_rate_weekly") @db.Decimal(12, 2)
  defaultRentalRateMonthly Decimal?        @map("default_rental_rate_monthly") @db.Decimal(12, 2)
  cost                     Decimal?        @db.Decimal(12, 2)
  isSerialized             Boolean         @default(false) @map("is_serialized")
  isAssembly               Boolean         @default(false) @map("is_assembly")
  isTaxable                Boolean         @default(false) @map("is_taxable")
  taxClassification        String?         @map("tax_classification")

  // QuickBooks Mapping
  qbItemListId   String?     @map("qb_item_list_id")
  qbItemFullName String?     @map("qb_item_full_name")
  qbItemType     QbItemType? @map("qb_item_type")

  // Enverus Mapping
  enverusProductServiceCode        String? @map("enverus_product_service_code")
  enverusProductServiceDescription String? @map("enverus_product_service_description")
  enverusUnitOfMeasure             String? @map("enverus_unit_of_measure")

  isActive   Boolean  @default(true) @map("is_active")
  customData Json?    @map("custom_data") @db.JsonB
