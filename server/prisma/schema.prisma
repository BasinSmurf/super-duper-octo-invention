model Company {
  id              String      @id @default(uuid())
  name            String
  legalName       String?     @map("legal_name")
  parentCompanyId String?     @map("parent_company_id")
  companyType     CompanyType @map("company_type")
  isActive        Boolean     @default(true) @map("is_active")
  // When true, this customer pays cash/card at time of service (no net-terms
  // billing on account). Surfaces the Stripe card-payment panel on their work
  // and a "Cash / Card only" warning; does not hard-block on-account invoicing.
  cashCcOnly      Boolean     @default(false) @map("cash_cc_only")
  // AR-flipped credit hold. Hard-blocks NEW work (tickets) and blocks releasing
  // equipment back to the customer from a shop work order — gear can still come
  // IN, it just can't leave until AR clears the hold. Independent of isActive:
  // a held customer stays visible and selectable so staff see WHY they're
  // blocked instead of the customer silently vanishing from the picker.
  creditHold      Boolean     @default(false) @map("credit_hold")

  // Contact & Address
  address String?
  city    String?
  state   String?
  zip     String?
  phone   String?
  email   String?
  website String?

  // Billing Config
  // Customer-facing wording, keyed by stable QuickBooks item ListID.
  customerDescriptions Json? @map("customer_descriptions") @db.JsonB
  paymentTerms      String? @map("payment_terms")
  dueDateOffset     Int?    @map("due_date_offset")
  priceBookNumber   String? @map("price_book_number")
  invoiceTemplateId String? @map("invoice_template_id")
  attachFieldTicket Boolean @default(true) @map("attach_field_ticket")
  attachInvoice     Boolean @default(true) @map("attach_invoice")

  // Per-customer field labels (what this customer calls their AFE/PO/WO/CC)
  afeLabel        String? @map("afe_label")
  poLabel         String? @map("po_label")
  woLabel         String? @map("wo_label")
  costCenterLabel String? @map("cost_center_label")

  // QuickBooks
  qbCustomerListId   String?       @map("qb_customer_list_id")
  qbCustomerFullName String?       @map("qb_customer_full_name")
  // When true, push a QB SalesOrder for this customer (legacy opt-in: a human
  // converts SO→Invoice in QB Desktop). Default false = post an Invoice directly.
  qbUsesSalesOrder   Boolean       @default(false) @map("qb_uses_sales_order")
  qbPriceLevel       String?       @map("qb_price_level") // legacy free-text label, kept for backfill
  qbSyncStatus       QbSyncStatus? @map("qb_sync_status")
  // Wave 5 5C — admin-assigned PriceLevel for this customer. Drives the
  // billing-rules resolver's per-line rate adjustments at invoice time.
  // Many companies → one PriceLevel allowed (a single "Tier 2" level can
  // be assigned to several customers). Independent of QB's CustomerRef
  // PriceLevelRef so admins can override what QB has — and so we don't
  // need a customer pull to make the apply path work.
  qbPriceLevelId     String?       @map("qb_price_level_id")

  // ND sales tax — destination-based. When taxExempt, invoice generation
  // defaults every line non-taxable (resale / direct-pay / government cert on
  // file). Still overridable per line on the draft invoice.
  taxExempt           Boolean @default(false) @map("tax_exempt")
  taxExemptCertNumber String? @map("tax_exempt_cert_number")

  // Metadata
  customData Json? @map("custom_data") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parentCompany           Company?                 @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies          Company[]                @relation("CompanyHierarchy")
  assignedPriceLevel      PriceLevel?              @relation(fields: [qbPriceLevelId], references: [id])
  operatorAliases         OperatorAlias[]
  portalUsers             User[]                   @relation("PortalUsers")
  billingProfiles         CustomerBillingProfile[]
  contacts                CustomerContact[]
  pads                    Pad[]
  wells                   Well[]
  facilities              Facility[]
  operatorHistoryPrev     OperatorHistory[]        @relation("PrevOperator")
  operatorHistoryNew      OperatorHistory[]        @relation("NewOperator")
  serviceTickets          ServiceTicket[]
  rentalAgreements        RentalAgreement[]
  rentalBoms              CustomerRentalBom[]
  repairOrders            RepairOrder[]
  billingGroups           BillingGroup[]
  serializedEquipment     SerializedEquipment[]
  dmrMatchedWells         DmrReferenceWell[]       @relation("MatchedCompany")
  serviceRoutes           ServiceRoute[]
  trainingRosterEmployees TrainingRosterRecord[]   @relation("TrainingEmployer")
  shopWorkOrders          ShopWorkOrder[]
  invoices                Invoice[]
  payments                Payment[]
  cpLocations             CpLocation[]             @relation("CpLocationCompany")
  cpSessions              CpScheduledSession[]     @relation("CpSessionCompany")
  cpRegistrations         CpSessionRegistration[]  @relation("CpRegistrationEmployer")
  trainingEmployerAliases TrainingEmployerAlias[]

  @@map("companies")
}

model OperatorAlias {
  id              String  @id @default(uuid())
  companyId       String  @map("company_id")
  dmrOperatorName String  @map("dmr_operator_name")
  isCurrent       Boolean @default(true) @map("is_current")
  notes           String?

  company Company @relation(fields: [companyId], references: [id])

  @@map("operator_aliases")
}

model CustomerBillingProfile {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  // Enverus Configuration
  enverusEnabled        Boolean            @default(false) @map("enverus_enabled")
  enverusReceiptMode    EnverusReceiptMode @default(none) @map("enverus_receipt_mode")
  enverusInvoiceMode    EnverusInvoiceMode @default(none) @map("enverus_invoice_mode")
  buyerDuns             String?            @map("buyer_duns")
  buyerSiteUuid         String?            @map("buyer_site_uuid")
  buyerDunsPlus4        String?            @map("buyer_duns_plus4")
  buyerCode             String?            @map("buyer_code")
  enverusCustomerUuid   String?            @map("enverus_customer_uuid")
  supplierDuns          String?            @map("supplier_duns")
  supplierSiteDunsPlus4 String?            @map("supplier_site_duns_plus4")

  // Cached buyer field rules from Enverus (OT or OI)
  // JSON shape: { fieldName: { visible, editable, requiredOn?, customLabel?, adeField?, itemID?, ... } }
  buyerFieldRules Json? @map("buyer_field_rules") @db.JsonB

  // Stacked Billing Config
  stackedBillingEnabled          Boolean               @default(false) @map("stacked_billing_enabled")
  stackedBillingGroupBy          BillingLevel?         @map("stacked_billing_group_by")
  stackedBillingPeriod           StackedBillingPeriod? @map("stacked_billing_period")
  stackedBillingFiscalMonthStart Int                   @default(1) @map("stacked_billing_fiscal_month_start")

  // Billing Level
  billingLevel BillingLevel @default(company) @map("billing_level")

  // Billing Defaults
  defaultOrderedByName String? @map("default_ordered_by_name")
  defaultAfeNumber     String? @map("default_afe_number")
  defaultCostCenter    String? @map("default_cost_center")
  defaultPoNumber      String? @map("default_po_number")
  requiresPo           Boolean @default(false) @map("requires_po")
  requiresAfe          Boolean @default(false) @map("requires_afe")
  requiresCostCenter   Boolean @default(false) @map("requires_cost_center")

  // Where this profile's AFE / cost center come from. `fixed` = the defaults
  // above (COP field work: Facility/Property is always "BK"). `location` = the
  // ticket's well, else its pad (Well/Pad.facilityCode → AFE, .costCenter →
  // cost center), with the default above as the fallback. Profiles already scope
  // by ticket type/division, so this gives work type × well without a profile per well.
  afeNumberSource  BillingFieldSource @default(fixed) @map("afe_number_source")
  costCenterSource BillingFieldSource @default(fixed) @map("cost_center_source")

  // The buyer's subcompany (Enverus buyer site, e.g. Hess Bakken Invest II LLC) and
  // remit-to department (e.g. Continental "Killdeer Field Office"). Same sources as
  // above: `fixed` = buyerSiteUuid / defaultBuyerDepartment, `location` = the well's,
  // else the pad's. The site rides on the receipt's buyerParty; the receipt API has
  // no department field, so the department is shown to billing for OI invoicing.
  buyerSiteSource         BillingFieldSource @default(fixed) @map("buyer_site_source")
  requiresBuyerSite       Boolean            @default(false) @map("requires_buyer_site")
  buyerDepartmentSource   BillingFieldSource @default(fixed) @map("buyer_department_source")
  defaultBuyerDepartment  String?            @map("default_buyer_department")
  requiresBuyerDepartment Boolean            @default(false) @map("requires_buyer_department")

  // Open Ticket defaults (COP / field-ticket.submit)
  defaultServiceApprover String? @map("default_service_approver")
  defaultPriceBookNumber String? @map("default_price_book_number")

  // Relabeled standard LINE-field defaults. The buyer relabels Enverus fields
  // (e.g. COP: major = "Activity Code" = "FA-L48", minor = "Functional Area" =
  // "L48_OPS_H_S"). afeNumber/costCenter defaults already live above. These
  // auto-fill at OT submit and are editable/clearable per invoice.
  defaultMajor String? @map("default_major")
  defaultMinor String? @map("default_minor")

  // Per-buyer display labels for the relabeled standard line fields, shown on the
  // OT submit panel so it speaks the buyer's vocabulary. JSON shape:
  // { afeNumber?, costCenter?, major?, minor? } → string label. Null/missing = use
  // the generic default label. UI-only; the builder never reads this.
  lineFieldLabels Json? @map("line_field_labels") @db.JsonB

  // Buyer-specific additional data fields (e.g. COP: Facility Property, Activity Code)
  // JSON shape: [{ code: string, name?: string, value: string, itemID?: string }]
  defaultAdditionalDataFields Json? @map("default_additional_data_fields") @db.JsonB

  // Identifies which additionalDataFields entry receives the well/pad facilityCode at
  // receipt-build time (matched by itemID, else code, else name). e.g. COP "Facility Property".
  // Null = no per-location injection (additionalDataFields stays as the static default).
  facilityCodeAdfKey String? @map("facility_code_adf_key")

  // Signature requirements (email-based flow)
  signatureRequired  SignatureRequired @default(none) @map("signature_required")
  signatureApprovers Json?             @map("signature_approvers") @db.JsonB
  // signatureApprovers JSON shape: [{ name: string, email: string }]

  // Repair Approval
  approvalRequired        ApprovalRequired @default(never) @map("approval_required")
  approvalThresholdAmount Decimal?         @map("approval_threshold_amount") @db.Decimal(12, 2)

  // Auto-approval kill switch: when false, routine (green) tickets for this
  // customer will NOT be auto-transitioned by approvalAutoProcessor even if
  // they sit in supervisor_review past the delay window. Always requires a
  // human supervisor click.
  autoApprovalEnabled Boolean @default(true) @map("auto_approval_enabled")

  // #4 Job-type scope. NULL/empty = unscoped company-wide default. A scoped
  // profile only applies to the listed ticket types / divisions; the selector
  // prefers the most-specific match and falls back to an unscoped default.
  // appliesToTicketTypes: TicketType tokens; appliesToDivisions: 'D3'|'D4'.
  appliesToTicketTypes Json? @map("applies_to_ticket_types") @db.JsonB
  appliesToDivisions   Json? @map("applies_to_divisions") @db.JsonB

  // Lifecycle
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdById   String?   @map("created_by_id")

  // Flexible fields
  billingOptions Json? @map("billing_options") @db.JsonB
  customData     Json? @map("custom_data") @db.JsonB

  // Relations
  company        Company         @relation(fields: [companyId], references: [id])
  createdBy      User?           @relation(fields: [createdById], references: [id])
  serviceTickets ServiceTicket[]
  billingGroups  BillingGroup[]
  invoices       Invoice[]

  @@map("customer_billing_profiles")
}

model CustomerContact {
  id        String      @id @default(uuid())
  companyId String      @map("company_id")
  name      String
  title     String?
  phone     String?
  email     String?
  role      ContactRole
  isPrimary Boolean     @default(false) @map("is_primary")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  serviceTickets ServiceTicket[]

  @@map("customer_contacts")
}

// ============================================================
// LOCATION HIERARCHY
// ============================================================

model DmrReferenceWell {
  id             String    @id @default(uuid())
  dmrFileNumber  Int?      @map("dmr_file_number")
  apiNumber      String?   @unique @map("api_number")
  apiShort       String?   @map("api_short")
  operatorName   String?   @map("operator_name")
  wellName       String?   @map("well_name")
  wellNameBase   String?   @map("well_name_base")
  totalDepth     Int?      @map("total_depth")
  spudDate       DateTime? @map("spud_date") @db.Date
  fieldName      String?   @map("field_name")
  quarterQuarter String?   @map("quarter_quarter")
  section        Int?
  township       Int?
  range          Int?
  feetNs         Int?      @map("feet_ns")
  nsLine         String?   @map("ns_line")
  feetEw         Int?      @map("feet_ew")
  ewLine         String?   @map("ew_line")
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  wellType       String?   @map("well_type")
  wellStatus     String?   @map("well_status")
  county         String?
  symbol         String?
  rawData        Json?     @map("raw_data") @db.JsonB

  // Match tracking
