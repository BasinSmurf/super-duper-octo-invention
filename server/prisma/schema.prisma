  techSignature        String? @map("tech_signature")

  // Descriptions
  dispatchNotes   String? @map("dispatch_notes")
  workDescription String? @map("work_description")
  internalNotes   String? @map("internal_notes")

  // Totals
  subtotal  Decimal? @db.Decimal(12, 2)
  taxAmount Decimal? @map("tax_amount") @db.Decimal(12, 2)
  total     Decimal? @db.Decimal(12, 2)

  // QuickBooks Sync
  qbInvoiceListId String? @map("qb_invoice_list_id")
  qbInvoiceNumber String? @map("qb_invoice_number")
  qbInvoiceTxnId  String? @map("qb_invoice_txn_id")
  billingGroupId  String? @map("billing_group_id")

  // Enverus Sync
  enverusReceiptId     String?               @map("enverus_receipt_id")
  enverusReceiptStatus EnverusReceiptStatus? @map("enverus_receipt_status")
  enverusInvoiceId     String?               @map("enverus_invoice_id")
  enverusInvoiceStatus String?               @map("enverus_invoice_status")

  // Signature tracking (email-based flow)
