  workPoint              WorkPoint?              @relation(fields: [workPointId], references: [id])
  presentRig             MobileAsset?            @relation("PresentRig", fields: [presentRigId], references: [id])
  billingProfile         CustomerBillingProfile? @relation(fields: [billingProfileId], references: [id])
  assignedTech           User?                   @relation("AssignedTech", fields: [assignedTechId], references: [id])
  dispatchedBy           User?                   @relation("DispatchedBy", fields: [dispatchedById], references: [id])
  reviewedBy             User?                   @relation("TicketReviewedBy", fields: [reviewedById], references: [id])
  billingReadinessSetBy  User?                   @relation("TicketBillingReadinessSetBy", fields: [billingReadinessSetById], references: [id])
  customerContact        CustomerContact?        @relation(fields: [customerContactId], references: [id])
  billingGroup           BillingGroup?           @relation(fields: [billingGroupId], references: [id])
  sourceTicket           ServiceTicket?          @relation("TicketSource", fields: [sourceTicketId], references: [id])
  derivedTickets         ServiceTicket[]         @relation("TicketSource")
  createdBy              User?                   @relation("TicketCreator", fields: [createdById], references: [id])
  signatureRequest       SignatureRequest?
  lineItems              TicketLineItem[]
  attachments            TicketAttachment[]
  unifiedAttachments     Attachment[]
  fitTestRecords         FitTestRecord[]
  repairOrdersFromTicket RepairOrder[]           @relation("RepairSourceTicket")
  repairOrderInvoices    RepairOrder[]           @relation("RepairInvoiceTicket")
  routeCycleVisits       RouteCycleVisit[]
  airSystemInspections   AirSystemInspection[]
  ihTestRecords          IhTestRecord[]
  gasDetectionRecords    GasDetectionRecord[]
  equipmentInspections   EquipmentInspection[]
  trainingRosterRecords  TrainingRosterRecord[]
  linkedRentalAgreement  RentalAgreement?        @relation(fields: [linkedRentalAgreementId], references: [id])
  payments               Payment[]
  billingDocLineRefs     BillingDocLineRef[]
