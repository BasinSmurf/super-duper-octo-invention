  rentalsBillingReleased        RentalAgreement[]               @relation("RentalBillingReleaser")
  rentalBomsCreated             CustomerRentalBom[]             @relation("RentalBomCreator")
  repairsDiagnosed              RepairOrder[]                   @relation("DiagnosedBy")
  repairsPerformed              RepairOrder[]                   @relation("RepairedBy")
  repairsQcTested               RepairOrder[]                   @relation("QcTestedBy")
  repairsCreated                RepairOrder[]                   @relation("RepairCreator")
  repairLabor                   RepairOrderLabor[]
  inventory                     Inventory[]
  auditLogs                     AuditLog[]
  assignedCycles                RouteCycle[]                    @relation("CycleTech")
  cycleVisits                   RouteCycleVisit[]               @relation("VisitedBy")
  airSystemInspections          AirSystemInspection[]           @relation("InspectedBy")
  ihTestsConducted              IhTestRecord[]                  @relation("IhTestedBy")
  equipmentInspectionsRecorded  EquipmentInspection[]           @relation("EquipmentInspectedBy")
  shopTransfersRecorded         ShopTransferEvent[]             @relation("ShopTransferEventBy")
  shopTransfersTransported      ShopTransferEvent[]             @relation("ShopTransferTransportedBy")
  shopTransfersReceived         ShopTransferEvent[]             @relation("ShopTransferReceivedBy")
  equipmentDocumentsUploaded    EquipmentDocument[]
  shopWosTransitInitiated       ShopWorkOrder[]                 @relation("ShopWOTransitInitiatedBy")
  // Shop work orders
  shopWOIntake                  ShopWorkOrder[]                 @relation("ShopIntakeBy")
  shopWOCreated                 ShopWorkOrder[]                 @relation("ShopWOCreator")
  unifiedAttachmentsUploaded    Attachment[]                    @relation("AttachmentUploader")
  shopItemsDiagnosed            ShopWorkOrderItem[]             @relation("ShopDiagnosedBy")
  shopItemsAssigned             ShopWorkOrderItem[]             @relation("ShopAssignedTo")
  shopItemsQcTested             ShopWorkOrderItem[]             @relation("ShopQcTestedBy")
  shopStatusChanges             ShopItemStatusLog[]             @relation("ShopStatusChanger")
