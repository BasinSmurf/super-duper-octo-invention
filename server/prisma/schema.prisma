// ============================================================
// BILLING LINEAGE & MIRRORED STATUS
// ============================================================
// Implements the Billing Status Ownership and Ticket-to-Invoice Lineage
// handoff. The four load-bearing rules:
//   1. ServiceTicket owns exactly one billing field: billingReadiness (above).
//   2. If a human can edit it in ServicePRO, ServicePRO owns it. Otherwise
//      it's a mirror — lives in BillingObservation, never a bare column.
//   3. Every mirror stores value + source + as-of + observed-at. Freshness is
//      computed, never stored.
//   4. serviceDate and invoiceDate are separate forever. serviceDate never
//      becomes the QuickBooks invoice date.
// No literal Postgres "billing" schema — this codebase has no multiSchema
// precedent (pinned Prisma 7.x), so these are flat public-schema tables under
// a billing_ table-name prefix, same discipline other modules use.

enum BillingDocType {
  invoice
  credit_memo
}

// A REFERENCE to a document that lives in QuickBooks — never the document
// itself. Immutable after creation except supersededById/qbTxnId/invoiceDate;
// enforced by a Postgres trigger (see migration — no existing trigger
// precedent in this repo, so this is the first one, hand-written and
// commented same as the equipment_inspections CHECK-constraint precedent).
model BillingDocRef {
  id             String         @id @default(uuid())
  docType        BillingDocType @map("doc_type")
  docNumber      String         @map("doc_number") // INV-2026-01187 / CM-2026-00042
  revision       Int            @default(1) // pre-acceptance resubmission only
  qbTxnId        String?        @map("qb_txn_id") // QuickBooks TxnID once known
  invoiceDate    DateTime?      @map("invoice_date") @db.Date // accounting fact, mirrored from QB
  supersedesId   String?        @map("supersedes_id")
  supersededById String?        @map("superseded_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  supersedes          BillingDocRef?       @relation("BillingDocRefSupersedes", fields: [supersedesId], references: [id])
  supersededBy        BillingDocRef?       @relation("BillingDocRefSupersededBy", fields: [supersededById], references: [id])
  supersededByReverse BillingDocRef[]      @relation("BillingDocRefSupersedes")
  supersedesReverse   BillingDocRef[]      @relation("BillingDocRefSupersededBy")
  lineRefs            BillingDocLineRef[]
  submissions         BillingSubmission[]
  observations        BillingObservation[] @relation("BillingObservationDocRef")

  @@unique([docNumber, revision])
  @@map("billing_doc_ref")
}

// Supports many tickets → one invoice, and line-level kickbacks.
model BillingDocLineRef {
  id           String   @id @default(uuid())
  docRefId     String   @map("doc_ref_id")
  lineNo       Int      @map("line_no")
  ticketId     String   @map("ticket_id") // originating ticket
  ticketNumber String   @map("ticket_number") // denormalized for search and rendering
  serviceDate  DateTime @map("service_date") @db.Date // operational fact, from the ticket — never invoiceDate
  amount       Decimal  @db.Decimal(14, 2)

  docRef       BillingDocRef        @relation(fields: [docRefId], references: [id])
  ticket       ServiceTicket        @relation(fields: [ticketId], references: [id])
  observations BillingObservation[] @relation("BillingObservationDocLineRef")

  @@unique([docRefId, lineNo])
  @@map("billing_doc_line_ref")
}

// One row per attempt to put a document in front of an operator.
model BillingSubmission {
  id          String    @id @default(uuid())
  docRefId    String    @map("doc_ref_id")
  destination String    @map("destination") // 'openinvoice' | 'operator_portal' | 'email'
  submittedAt DateTime  @map("submitted_at")
  submittedBy String    @map("submitted_by")
  externalRef String?   @map("external_ref") // OI submission / document id
  outcome     String?   @map("outcome") // 'accepted' | 'rejected' | null = pending
  reasonCode  String?   @map("reason_code") // controlled vocabulary — see BillingReasonCode
  reasonNote  String?   @map("reason_note")
  resolvedAt  DateTime? @map("resolved_at")

  docRef BillingDocRef @relation(fields: [docRefId], references: [id])

  @@map("billing_submission")
}

// The mirror table. Deliberately generic — this is where the "no bare paid
// column" guarantee lives. Append-only; corrections are new rows with a later
// asOf. Current value = latest asOf per (subject, factKey). Exactly one of
// docRefId/docLineRefId/ticketId is set — same typed-nullable-FK polymorphism
// this codebase already uses on Payment (ticketId/shopWorkOrderId/invoiceId),
// preferred here over a generic subjectType/subjectId pair because it keeps
// real referential integrity per subject type.
model BillingObservation {
  id           String   @id @default(uuid())
  docRefId     String?  @map("doc_ref_id")
  docLineRefId String?  @map("doc_line_ref_id")
  ticketId     String?  @map("ticket_id")
  factKey      String   @map("fact_key") // 'accepted' | 'disputed' | 'paid' | 'credited' | 'written_off' | 'amount_paid' | ...
  factValue    Json     @map("fact_value") @db.JsonB
  source       String // 'quickbooks' | 'openinvoice' | 'human'
  sourceActor  String?  @map("source_actor") // REQUIRED when source = 'human'
  asOf         DateTime @map("as_of") // when the source asserted it — never the sync-run time
  observedAt   DateTime @default(now()) @map("observed_at")

  docRef     BillingDocRef?     @relation("BillingObservationDocRef", fields: [docRefId], references: [id])
  docLineRef BillingDocLineRef? @relation("BillingObservationDocLineRef", fields: [docLineRefId], references: [id])
  ticket     ServiceTicket?     @relation("BillingObservationTicket", fields: [ticketId], references: [id])

  @@index([docRefId, factKey, asOf(sort: Desc)])
  @@index([docLineRefId, factKey, asOf(sort: Desc)])
  @@index([ticketId, factKey, asOf(sort: Desc)])
  @@map("billing_observation")
}

// Admin-editable reason-code vocabulary (not free text) — same shape as
// GoogleRoleMapping: seeded idempotently in a migration, editable afterwards
// through app UI, no migration needed to add/retire a code.
model BillingReasonCode {
  id              String   @id @default(uuid())
  code            String   @unique
  phase           String // 'pre_acceptance' | 'post_acceptance'
  label           String
  resultingAction String?  @map("resulting_action")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("billing_reason_code")
}

model TicketLineItem {
  id            String       @id @default(uuid())
  ticketId      String       @map("ticket_id")
  lineNumber    Int          @map("line_number")
  lineType      LineItemType @map("line_type")
  productId     String?      @map("product_id")
  description   String?
  quantity      Decimal      @db.Decimal(10, 2)
  unitOfMeasure String?      @map("unit_of_measure")
  rate          Decimal?     @db.Decimal(12, 2)
  total         Decimal?     @db.Decimal(12, 2)

  // Labor
  hoursRegular  Decimal? @map("hours_regular") @db.Decimal(6, 2)
  hoursOvertime Decimal? @map("hours_overtime") @db.Decimal(6, 2)
  hoursTravel   Decimal? @map("hours_travel") @db.Decimal(6, 2)

  // Parts
  partNumber String? @map("part_number")

  // Serialized equipment
  serialNumberInstalled String? @map("serial_number_installed")
  serialNumberRemoved   String? @map("serial_number_removed")
  equipmentIdInstalled  String? @map("equipment_id_installed")
  equipmentIdRemoved    String? @map("equipment_id_removed")

  // Bump test / calibration
  testResult      TestResult? @map("test_result")
  calGasLotNumber String?     @map("cal_gas_lot_number")

  // Rental
  rentalAgreementId String?   @map("rental_agreement_id")
  rentalStartDate   DateTime? @map("rental_start_date") @db.Date
  rentalEndDate     DateTime? @map("rental_end_date") @db.Date

  // Location override
  wellIdOverride      String? @map("well_id_override")
  workPointIdOverride String? @map("work_point_id_override")

  // Enverus per-line
  enverusProductServiceCode String? @map("enverus_product_service_code")
  enverusAfeNumber          String? @map("enverus_afe_number")
  enverusCostCenter         String? @map("enverus_cost_center")

  // Wave 5 Slice 5A — billing-rules engine flag (parity with InvoiceLineItem.qbSkip).
  // Currently only set on invoice-side surcharges; reserved here for future
  // ticket-side rules (e.g. line-by-line markups) that would round-trip
