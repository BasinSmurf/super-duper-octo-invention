  // Field service: was a rig present on-site? Independent of the main
  // location — a rig isn't "the" location, just noted context for this visit.
  rigPresent   Boolean @default(false) @map("rig_present")
  presentRigId String? @map("present_rig_id")
  // Free-text rig number typed by the tech. Supersedes presentRigId (legacy
  // MobileAsset pick): rigs are no longer a selectable equipment record.
  presentRigNumber String? @map("present_rig_number")

  // Denormalized for display + offline + billing
