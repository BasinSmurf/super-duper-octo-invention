  afeNumber      String? @map("afe_number")
  poNumber       String? @map("po_number")
  costCenter     String? @map("cost_center")
  contractNumber String? @map("contract_number")
  // #3 Structured billing refs — source of truth for the repeater UI. The flat
  // afe/po/cost above are DERIVED (first value per type) and remain the contract
  // for QB + Enverus. Shape: [{ id, type:'po'|'afe'|'cost_code', value, required }]
  billingRefs    Json?   @map("billing_refs") @db.JsonB

  // Internal classification — drives QuickBooks Class on SalesOrder header.
  // division + isDickinson together resolve to one of four QB class strings.
  division    ServiceDivision? @map("division")
  isDickinson Boolean          @default(false) @map("is_dickinson")

  // On-Site Contact
  customerContactId String? @map("customer_contact_id")
  customerRepName   String? @map("customer_rep_name")

