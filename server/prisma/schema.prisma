// ============================================================
// EQUIPMENT INSPECTION (Wave 1 — unified shop + field)
// ============================================================
// One inspection record per piece of equipment serviced. Belongs to EXACTLY ONE
// of: a ShopWorkOrderItem (shop intake → service workflow) or a ServiceTicket
// (field inspection workflow). Enforced via raw-SQL CHECK in the migration.
//
// Design:
//   - Hybrid storage: top-level common fields + category-discriminated JSONB
//     `data` blob (mirrors AirSystemInspection.cylinders / serviceActions
//     pattern). Avoids per-category sub-tables.
//   - Multi-select serviceActions (vocab per category, validated at API/UI).
//   - Append-only event log: once `lockedAt` is set, server rejects updates.
//     Corrections file a new record with `correctsId` pointing at the prior.
//   - Outcome enum drives SerializedEquipment.status flow-back.
//
// Coexistence: AirSystemInspection / GasDetectionRecord / IhTestRecord stay
// for now (Wave 1 = coexist). Migration into EquipmentInspection is a later wave.

model EquipmentInspection {
  id String @id @default(uuid())

  // Parent — exactly one populated. CHECK constraint added in migration.
  shopItemId String? @map("shop_item_id")
  ticketId   String? @map("ticket_id")

  // Equipment identity (snapshotted so historical record survives renames/reassigns)
  serializedEquipmentId String?                     @map("serialized_equipment_id")
  serialNumber          String                      @map("serial_number")
  category              EquipmentInspectionCategory

  // Outcome — drives equipment lifecycle flow-back (services/equipmentLifecycle.ts)
  outcome InspectionOutcome

  // Multi-select actions performed on this equipment.
  // Vocab depends on category; validated at API/UI layer (no Prisma enum).
  //   FEX:          ["annual","recharge","recharge_annual","six_year","twelve_year_hydro","condemn","cannot_service","parts_replaced"]
  //   gas_detection:["bump_test","calibration","electronic_service","sensor_replace","remove_from_service","parts_replaced"]
  //   scba:         ["air_fill_inspection","air_fill","flow_test","posi_check","component_service","mask_service","regulator_service","parts_replaced"]
  //   fall_arrest:  TBD pending DeWalt form pull
  serviceActions Json @default("[]") @map("service_actions") @db.JsonB

  // Category-specific data — JSONB, shape determined by category.
  //   fire_extinguisher:   { brand, type, size, location }
  //   gas_detection:       { make, model, sensors[], lastCalibration, sensorReplaced }
  //   scba:                { hydroDate, posiCheckDate, maskSize, maskCondition, regulatorSerial, blockReducerSerial, ... }
  //   fall_arrest:         TBD
  //   ue_cylinder:         { hydroDate, ueResult, wallThicknessReadings[] }
  //   breathing_air_system:{ cascadePsi, flowRate, ... }
  //   first_aid_kit:       { contentsChecklist }
  data Json @default("{}") @db.JsonB

  // Last-mile escape hatches. Use sparingly — structured fields preferred.
  partsReplaced String? @map("parts_replaced")
  notes         String?

  // Tech / time
  inspectedById String?  @map("inspected_by_id")
  inspectedAt   DateTime @map("inspected_at")

  // Customer approval signature on this specific inspection (separate from
  // the WO/ticket-level signature; matches the work-form footer).
  customerApprovedName      String?   @map("customer_approved_name")
  customerApprovedSignature String?   @map("customer_approved_signature") @db.Text
  customerApprovedAt        DateTime? @map("customer_approved_at")

  // Append-only / event-log. Once lockedAt is set, server rejects updates.
  // UI must surface this as an explicit confirm: "Locking permanently — corrections
  // require a new inspection record. Continue?"
  lockedAt   DateTime? @map("locked_at")
  correctsId String?   @map("corrects_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  shopItem            ShopWorkOrderItem?              @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  ticket              ServiceTicket?                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  serializedEquipment SerializedEquipment?            @relation(fields: [serializedEquipmentId], references: [id])
  inspectedBy         User?                           @relation("EquipmentInspectedBy", fields: [inspectedById], references: [id])
  corrects            EquipmentInspection?            @relation("InspectionCorrections", fields: [correctsId], references: [id])
  correctedBy         EquipmentInspection[]           @relation("InspectionCorrections")
  attachments         Attachment[]
  documents           EquipmentDocument[]
  qaUnitResult        ShopQaUnitResult?

  @@index([shopItemId])
  @@index([ticketId])
  @@index([serializedEquipmentId])
  @@index([serialNumber])
  @@map("equipment_inspections")
}

// Evidence files attached to an inspection — condemn / cannot-service photos and
// the external UE report PDF. Mirrors TicketAttachment. NOT part of the
// inspection's append-only lock: evidence can arrive after the record is locked,
// so attachments are added/removed independently of lockedAt.
// Documents that belong to a UNIT rather than to the inspection that produced
// them: UE reports and condemnation certs. Attachments hang off an inspection,
// which can't answer "every UE report for cylinder CYL88213" without walking
// every inspection that ever touched it — and BlueLion attaches these to the
// cylinder's asset id, so the two models have to agree.
//
// `revision` exists from day one because BlueLion dedupes documents on
// externalId: a corrected UE report re-pushed under the same id comes back
// `skipped` and their copy stays stale. Bumping the revision changes the
// externalId, so corrections land.
model EquipmentDocument {
  id            String                @id @default(uuid())
  equipmentId   String                @map("equipment_id")
  docType       EquipmentDocumentType @map("doc_type")
  revision      Int                   @default(1)
  storageKey    String                @map("storage_key")
  fileName      String                @map("file_name")
  mimeType      String?               @map("mime_type")
  fileSizeBytes Int?                  @map("file_size_bytes")
  issuedOn      DateTime?             @map("issued_on") @db.Date
  // Provenance, not ownership — null for a document uploaded standalone.
  inspectionId  String?               @map("inspection_id")
  // BlueLion cross-reference: the docId their /documents endpoint returns, so
  // SP can deep-link into their public record page.
  blueLionDocId    String?   @map("bluelion_doc_id")
  blueLionSyncedAt DateTime? @map("bluelion_synced_at")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  uploadedById     String?   @map("uploaded_by_id")

  equipment  SerializedEquipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  inspection EquipmentInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  uploadedBy User?                @relation(fields: [uploadedById], references: [id])

  @@unique([equipmentId, docType, revision])
  @@index([equipmentId])
  @@index([inspectionId])
  @@map("equipment_documents")
}

enum EquipmentDocumentType {
  ultrasonic_exam
  hydrostatic_test
  condemnation
  other
}

/// Attachment -- ONE table for every file this batch captures.
///
/// Replaces EquipmentInspectionAttachment (backfilled and dropped in the same
/// migration). TicketAttachment is deliberately NOT folded in yet: it is read
/// by the ticket wizard, the PDF generators and the Enverus payload builder,
/// and moving it belongs in its own change rather than riding along with a
/// foundation PR. The ticketId column exists so that move is a data migration
/// and not another schema debate.
///
/// PARENT: exactly one of shopItemId / inspectionId / ticketId, enforced by a
/// CHECK constraint, matching the pattern EquipmentInspection already uses.
///
/// IDENTITY: serialNumber is snapshotted at capture rather than looked up
/// through the parent. An attachment's meaning is "this is evidence about the
/// unit stamped SN-1234" -- that has to survive the parent row being
/// reorganised, the unit being reassigned, or a Vault record being merged.
model Attachment {
  id String @id @default(uuid())

  // Parent (exactly one; CHECK constraint in the migration)
  shopItemId   String? @map("shop_item_id")
  inspectionId String? @map("inspection_id")
  ticketId     String? @map("ticket_id")

  // Equipment identity, snapshotted at capture. serializedEquipmentId is the
  // resolved Vault/BlueLion record once identity resolution has run (WI-05
  // resolves at close, so this is null for a while by design).
  serialNumber          String? @map("serial_number")
  serializedEquipmentId String? @map("serialized_equipment_id")

  kind          AttachmentKind
  fileName      String  @map("file_name")
  mimeType      String? @map("mime_type")
  fileSizeBytes Int?    @map("file_size_bytes")

  /// SHA-256 of the bytes, computed on the SP server at ingest. This is what
  /// makes "verified" mean something: the promotion step re-reads the object
  /// back out of the remote store and compares against this before deleting
  /// the buffer copy. A truncated or silently-corrupted upload fails the
  /// comparison and the buffer is kept.
  sha256 String

  storageState    AttachmentStorageState @default(buffered) @map("storage_state")
  /// Key in the SP server's local durability buffer. Cleared once verified remote.
  bufferKey       String?   @map("buffer_key")
  /// Key in the object store. Set only after a verified upload.
  remoteKey       String?   @map("remote_key")
  uploadAttempts  Int       @default(0) @map("upload_attempts")
  lastUploadError String?   @map("last_upload_error")
  lastAttemptAt   DateTime? @map("last_attempt_at")
  uploadedAt      DateTime? @map("uploaded_at")

  /// The capturing device's local blob id, echoed back so it can match our ack
  /// to the right local file and only then delete it.
  offlineBlobId String? @map("offline_blob_id")

  /// VaultPRO (BlueLion) cross-reference, set once the async push confirms.
  /// Null is the normal state for a while: SP is the capture system of record
  /// and the immediate read path, and the push waits on the unit's Vault
  /// identity being resolved. Nothing user-facing blocks on this.
  blueLionDocId    String?   @map("bluelion_doc_id")
  blueLionSyncedAt DateTime? @map("bluelion_synced_at")

  capturedAt   DateTime  @default(now()) @map("captured_at")
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shopItem            ShopWorkOrderItem?   @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  inspection          EquipmentInspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  ticket              ServiceTicket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  serializedEquipment SerializedEquipment? @relation(fields: [serializedEquipmentId], references: [id])
  uploadedBy          User?                @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([shopItemId])
  @@index([inspectionId])
  @@index([ticketId])
  @@index([serialNumber])
  // The uploader's work queue: everything not yet safely remote, oldest first.
  @@index([storageState, lastAttemptAt])
  @@map("attachments")
}


// ============================================================
// TRAINING CLASS ROSTER RECORDS
// ============================================================

model TrainingRosterRecord {
  id       String @id @default(uuid())
  ticketId String @map("ticket_id")

  // Trainee identity
  employeeName String  @map("employee_name")
  employeeId   String? @map("employee_id")

  // Employer (drives billing — each employer gets a separate invoice)
  employerName      String? @map("employer_name")
  employerCompanyId String? @map("employer_company_id")

  // Contact info (for card redistribution)
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // Course info (denormalized from ticket for billing clarity)
  courseName String @map("course_name")

  // Training result
  passed Boolean @default(true)

  // Card issuance tracking
  cardIssuedOnSite   Boolean   @default(false) @map("card_issued_on_site")
  cardIssuedOfficial Boolean   @default(false) @map("card_issued_official")
  cardNumber         String?   @map("card_number")
  cardExpiryDate     DateTime? @map("card_expiry_date") @db.Date

  notes     String?
  trainedAt DateTime @map("trained_at")

  // #13 QR self-sign-in: student signed on their phone via the public link
  participantSignature String?   @map("participant_signature") @db.Text
  signedAt             DateTime? @map("signed_at")

  // BlueLion sync — set once the cert is accepted by BlueLion. blueLionPersonId
  // is reused on later pushes for the same person (the only fully-reliable id);
  // trainingSeq is BlueLion's event sequence for this granted training.
  blueLionPersonId    String?   @map("bluelion_person_id")
  blueLionTrainingSeq Int?      @map("bluelion_training_seq")
  blueLionSyncedAt    DateTime? @map("bluelion_synced_at")

  // BlueLion card.issued flag — stamped by the inbound receiver when a physical
  // wallet card is printed for this training. Distinct from cardIssuedOnSite/
  // cardIssuedOfficial (Sundog's own issuance workflow booleans).
  blueLionCardId       String?   @map("bluelion_card_id")
  blueLionCardIssuedAt DateTime? @map("bluelion_card_issued_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  ticket          ServiceTicket @relation(fields: [ticketId], references: [id])
  employerCompany Company?      @relation("TrainingEmployer", fields: [employerCompanyId], references: [id])

  @@index([employeeName, blueLionPersonId])
  @@map("training_roster_records")
}

/// Employer-name alias for training rosters — "kraken" → Kraken Oil & Gas.
/// `alias` is stored NORMALIZED (uppercase, collapsed whitespace — see
/// companyMerge.normalizeName). Written when a trainer-admin confirms a match
/// in the reconcile pane; read by the silent auto-matcher on QR self-sign-in
/// and ClassPRO session pre-registration. Core table (not cp_) because the
/// roster records it serves are core Sundog.
model TrainingEmployerAlias {
  id        String   @id @default(uuid())
  alias     String   @unique
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("training_employer_aliases")
}

// ============================================================
// RENTAL AGREEMENTS & DAILY LOGS
// ============================================================

model RentalAgreement {
  id                       String           @id @default(uuid())
  agreementNumber          String           @unique @map("agreement_number")
  companyId                String           @map("company_id")
  fieldId                  String?          @map("field_id")
  padId                    String?          @map("pad_id")
  wellId                   String?          @map("well_id") // primary/legacy well (= wellIds[0]); kept for QB/PDF consumers
  // All wells selected for this rental. The picker is multi-select; we surface
  // the individual wells (not the field) on the rental card. Shape: string[].
  wellIds                  Json             @default("[]") @map("well_ids") @db.JsonB
  facilityId               String?          @map("facility_id")
  status                   RentalStatus     @default(active)
  pickupType               RentalPickupType @default(dispatch) @map("pickup_type")
  startDate                DateTime         @map("start_date") @db.Date
  endDate                  DateTime?        @map("end_date") @db.Date
  billingRateType          RentalRateType   @map("billing_rate_type")
  // How often to actually invoice — usually monthly, sometimes weekly.
  // Distinct from billingRateType, which is the per-period RATE, not the
  // invoicing frequency. Drives the "ready to bill" notification watcher.
  billingCadence           RentalRateType   @default(monthly) @map("billing_cadence")
  billingPolicy            Json             @default("{\"pauses\":[],\"ticketRates\":null}") @map("billing_policy") @db.JsonB
  // The billing period (nextDueDate from rentalBilling.ts) already notified
  // for — dedups the watcher without a blind time-based cooldown; it
  // naturally re-fires once billing actually advances.
  lastBillReadyNotifiedFor DateTime?        @map("last_bill_ready_notified_for") @db.Date
  // "Send for billing" (services/rentalBillingRelease.ts). An active rental is
  // in AR's Ready queue only while this date is ahead of what has actually been
  // invoiced. Frozen at the day the supervisor clicked. Closed rentals need no
  // stamp — closing is the send.
  billingReleasedThrough   DateTime?        @map("billing_released_through") @db.Date
  billingReleasedAt        DateTime?        @map("billing_released_at")
  billingReleasedById      String?          @map("billing_released_by_id")
  // Non-null = an AR Supervisor forced this release without the field, which
  // skips the ticket-approval gate. Holds their stated reason.
  billingReleaseForceReason String?         @map("billing_release_force_reason")
  poNumber                 String?          @map("po_number")
  afeNumber                String?          @map("afe_number")
  notes                    String?

  // Liability waiver
  liabilityAcknowledged Boolean   @default(false) @map("liability_acknowledged")
  liabilitySignedByName String?   @map("liability_signed_by_name")
  liabilitySignature    String?   @map("liability_signature") @db.Text
  liabilitySignedAt     DateTime? @map("liability_signed_at")

  // Billing classification toggles
  isManned         Boolean @default(true) @map("is_manned")
  isRigJob         Boolean @default(false) @map("is_rig_job")
  monitorsIncluded Boolean @default(false) @map("monitors_included")

  // Site contact (for on-site issues/questions)
  siteContactName  String? @map("site_contact_name")
  siteContactPhone String? @map("site_contact_phone")
  siteContactEmail String? @map("site_contact_email")

  // Person who called in / requested the rental (Phase C dispatch capture)
  personCallingName  String? @map("person_calling_name")
  personCallingPhone String? @map("person_calling_phone")
  personCallingEmail String? @map("person_calling_email")

  // PIC roster — persons-in-charge / forepersons on the job (multi, edited from
  // the manned-trailer ticket, written through here so the agreement stays the
  // canonical contact log a relieving tech can pick up and call down.
  // Shape: [{ id, name, phone, email?, addedAt, addedBy }]
  pics Json? @map("pics") @db.JsonB

  // #C Rental composition (dispatch-time spec/BOM). Stackable: trailer (+manned),
  // gas monitors (QB product specs), other items, drilling-rig BOM. The flat
  // isManned/isRigJob/monitorsIncluded booleans above are DERIVED from this for
  // back-compat. Serials are still scanned into RentalAgreementItem at deploy.
  // Shape: { trailer:{manned}|null, gasMonitors:[{id,productId,productName?,qty}],
  //          other:[{id,label,qty,productId?}], drillingRig:bool, bom?:[{label,qty}] }
  composition Json? @map("composition") @db.JsonB

  // Dispatcher who created the contract (auto from logged-in user)
  createdById String? @map("created_by_id")

  // The shop this rental is run out of -- where the gear leaves from and comes
  // back to. Defaults to the creating dispatcher's home site, overridable at
  // creation. Nullable on purpose: agreements written before this column exists
  // have no honest answer, and guessing one would silently put them on a wall
  // board they don't belong to. A null lands in "Unassigned", not on a site.
  siteId String? @map("site_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company              Company               @relation(fields: [companyId], references: [id])
  field                Field?                @relation(fields: [fieldId], references: [id])
  pad                  Pad?                  @relation(fields: [padId], references: [id])
  well                 Well?                 @relation(fields: [wellId], references: [id])
  facility             Facility?             @relation(fields: [facilityId], references: [id])
  createdBy            User?                 @relation("RentalCreator", fields: [createdById], references: [id])
  billingReleasedBy    User?                 @relation("RentalBillingReleaser", fields: [billingReleasedById], references: [id], onDelete: SetNull)
  site                 Site?                 @relation(fields: [siteId], references: [id])
  items                RentalAgreementItem[]
  dailyLogs            RentalDailyLog[]
  serializedEquipment  SerializedEquipment[]
  linkedServiceTickets ServiceTicket[]

  // The board queries by site + pickup type + status; status is already the
  // outer filter, so lead with site.
  @@index([siteId, pickupType])
  @@map("rental_agreements")
}

model RentalAgreementItem {
  id                    String           @id @default(uuid())
  rentalAgreementId     String           @map("rental_agreement_id")
  productId             String           @map("product_id")
  serializedEquipmentId String           @map("serialized_equipment_id")
  // Explicit substitution: outgoing equipment stops billing on this item's
  // deployment date. Independent additions retain inclusive return billing.
  replacesItemId        String?          @unique @map("replaces_item_id")
  rate                  Decimal?         @db.Decimal(12, 2)
  rateType              RentalRateType   @map("rate_type")
  deployedDate          DateTime         @map("deployed_date") @db.Date
  returnedDate          DateTime?        @map("returned_date") @db.Date
  status                RentalItemStatus @default(deployed)
  // #19/#20 deploy QA gate answers for this unit (per-category checklist;
  // flagged items carry required notes). Assembly children store {coveredBy}.
  deployInspection      Json?            @map("deploy_inspection") @db.JsonB

  rentalAgreement     RentalAgreement     @relation(fields: [rentalAgreementId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])
  serializedEquipment SerializedEquipment @relation(fields: [serializedEquipmentId], references: [id])

  @@map("rental_agreement_items")
}

model RentalDailyLog {
  id                String   @id @default(uuid())
  rentalAgreementId String   @map("rental_agreement_id")
  logDate           DateTime @map("log_date") @db.Date
  loggedById        String   @map("logged_by_id")

  // Presence & Status
  equipmentPresent Boolean              @map("equipment_present")
  equipmentStatus  EquipmentCheckStatus @map("equipment_status")

  // Air cascade trailers
  cascadeStatus     CascadeStatus? @map("cascade_status")
  bottlesFullCount  Int?           @map("bottles_full_count")
  bottlesTotalCount Int?           @map("bottles_total_count")

  // Monitor trailers
  monitorsBumpTested       Boolean? @map("monitors_bump_tested")
  monitorsOperationalCount Int?     @map("monitors_operational_count")
  monitorsTotalCount       Int?     @map("monitors_total_count")

  notes String?

  // Site log entries (timestamped H2S readings + activity notes)
  entries Json? @map("entries") @db.JsonB

  // Offline
  offlineId      String? @map("offline_id")
  offlineCreated Boolean @default(false) @map("offline_created")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rentalAgreement RentalAgreement @relation(fields: [rentalAgreementId], references: [id])
  loggedBy        User            @relation(fields: [loggedById], references: [id])

  @@map("rental_daily_logs")
}

// A customer's rental Bill of Materials — the baseline gear their flat
// (rig-up + daily) rate covers. Standard = default; Drilling = the named
// package the rig-job toggle resolves to. Anything a job deploys ABOVE this
// baseline bills as generic add-on lines; the BOM contents themselves never
// itemize on the invoice. Keyed on equipment TYPE (catalogCategory), never
// serials — serials are captured at rig-up but carry no billing rate
// ("Schrödinger's billing line"). Ownership = createdBy; change history lives
// in AuditLog (entityType="customer_rental_bom"), so this is an audited entity,
// not an untracked config blob.
enum RentalBomType {
  standard
  manned
  unmanned
  other
  rig
  drilling
}

model CustomerRentalBom {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  bomType       RentalBomType @default(standard) @map("bom_type")
  // A customer can hold several packages of the same type — the variants
  // their MSA prices separately ("w/ gas detection" vs "no monitors"). The
  // name tells them apart on the dispatch picker; the bound QB item below is
  // what tells them apart on the invoice. isDefault = which variant dispatch
  // preselects for its type (at most one per company+type, enforced in the API).
  name          String?
  isDefault     Boolean       @default(false) @map("is_default")
  // Manned trailer → the flat rate includes `includedTechs` technicians;
  // additional techs on a job bill as a separate rig-up line (QB 406).
  manned        Boolean       @default(true)
  includedTechs Int           @default(0) @map("included_techs")
  // The QB item the WHOLE package bills as — one flat line per billing period
  // ("Standard Package @ daily rate"), not one line per baseline row. Carrying
  // a real Product is what makes the customer's MSA price level apply: the
  // invoice resolver matches on qbItemListId, so a productless line silently
  // bills at list. Nullable — an unbound package stays descriptive/$0, exactly
  // how every BOM behaved before this existed.
  packageProductId String?    @map("package_product_id")
  notes         String?
  isActive      Boolean       @default(true) @map("is_active")
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  company        Company                 @relation(fields: [companyId], references: [id])
  createdBy      User?                   @relation("RentalBomCreator", fields: [createdById], references: [id])
  packageProduct Product?                @relation("RentalBomPackageProduct", fields: [packageProductId], references: [id])
  items          CustomerRentalBomItem[]

  @@index([companyId, bomType])
  @@index([packageProductId])
  @@map("customer_rental_boms")
}

model CustomerRentalBomItem {
  id                String  @id @default(uuid())
  bomId             String  @map("bom_id")
  // Equipment TYPE, holding a `ProductCategory` value (monitor_area,
  // supplied_air_component, etc.) — the same axis deployed gear resolves to
  // via Product.category, so Wave 5's deploy-diff is a group-by-category
  // comparison. Stored as TEXT (loose-coupled, vocab validated at UI/API),
  // NOT a specific product/serial. Distinct from Product.catalogCategory (the
  // free-form billing facet).
  equipmentCategory String  @map("equipment_category")
  // Optional display override when the category label alone is ambiguous.
  label             String?
  qty               Int     @default(1)
  sortOrder         Int     @default(0) @map("sort_order")
  // The QB item an OVERAGE of this row bills as. The baseline itself is covered
  // by the package line above; this only prices the delta when a job deploys
  // MORE than the package covers (5 monitors against a baseline of 4 → 1 unit
  // on this product). Nullable — unbound rows still diff (category is the axis),
  // they just can't auto-price, and surface as an unrated extra for AR.
  productId         String? @map("product_id")

  bom     CustomerRentalBom @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product?          @relation("RentalBomItemProduct", fields: [productId], references: [id])

  @@index([productId])
  @@map("customer_rental_bom_items")
}

// ============================================================
// REPAIR/SERVICE ORDERS
// ============================================================

model RepairOrder {
  id           String       @id @default(uuid())
  repairNumber String       @unique @map("repair_number")
  status       RepairStatus @default(intake)

  // Unit being repaired
  serializedEquipmentId String @map("serialized_equipment_id")
  serialNumber          String @map("serial_number")
  productId             String @map("product_id")

  // Source / Origin
  sourceType     RepairSourceType @map("source_type")
  sourceTicketId String?          @map("source_ticket_id")
  reportedIssue  String?          @map("reported_issue")

  // Customer & Billing
  companyId      String?            @map("company_id")
  isBillable     Boolean            @default(true) @map("is_billable")
  isWarranty     Boolean            @default(false) @map("is_warranty")
  warrantyVendor String?            @map("warranty_vendor")
  ownerType      EquipmentOwnership @map("owner_type")

  // Diagnosis
  diagnosisNotes String?   @map("diagnosis_notes")
  diagnosedById  String?   @map("diagnosed_by_id")
  diagnosedAt    DateTime? @map("diagnosed_at")

  // Quote
  estimatedCost   Decimal?  @map("estimated_cost") @db.Decimal(12, 2)
  quoteSentAt     DateTime? @map("quote_sent_at")
  quoteApprovedAt DateTime? @map("quote_approved_at")
  quoteApprovedBy String?   @map("quote_approved_by")
  quoteNotes      String?   @map("quote_notes")

  // Repair
  repairedById      String?   @map("repaired_by_id")
  repairNotes       String?   @map("repair_notes")
  repairCompletedAt DateTime? @map("repair_completed_at")

  // QC / Testing
  qcTestedById  String?     @map("qc_tested_by_id")
  qcResult      TestResult? @map("qc_result")
  qcNotes       String?     @map("qc_notes")
  qcCompletedAt DateTime?   @map("qc_completed_at")

  // Completion
  returnMethod   ReturnMethod? @map("return_method")
  returnedAt     DateTime?     @map("returned_at")
  trackingNumber String?       @map("tracking_number")

  // Invoice linking
  invoiceTicketId String? @map("invoice_ticket_id")

  customData  Json?    @map("custom_data") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")

  // Relations
  serializedEquipment SerializedEquipment @relation(fields: [serializedEquipmentId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])
  sourceTicket        ServiceTicket?      @relation("RepairSourceTicket", fields: [sourceTicketId], references: [id])
  company             Company?            @relation(fields: [companyId], references: [id])
  diagnosedBy         User?               @relation("DiagnosedBy", fields: [diagnosedById], references: [id])
  repairedBy          User?               @relation("RepairedBy", fields: [repairedById], references: [id])
  qcTestedBy          User?               @relation("QcTestedBy", fields: [qcTestedById], references: [id])
  invoiceTicket       ServiceTicket?      @relation("RepairInvoiceTicket", fields: [invoiceTicketId], references: [id])
  createdBy           User?               @relation("RepairCreator", fields: [createdById], references: [id])
  parts               RepairOrderPart[]
  labor               RepairOrderLabor[]

  @@map("repair_orders")
}

model RepairOrderPart {
  id            String   @id @default(uuid())
  repairOrderId String   @map("repair_order_id")
  productId     String   @map("product_id")
  partNumber    String   @map("part_number")
  description   String?
  quantity      Int
  unitCost      Decimal? @map("unit_cost") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@map("repair_order_parts")
}

model RepairOrderLabor {
  id            String          @id @default(uuid())
  repairOrderId String          @map("repair_order_id")
  userId        String          @map("user_id")
  hours         Decimal         @db.Decimal(6, 2)
  laborType     RepairLaborType @map("labor_type")
  workDate      DateTime        @map("work_date") @db.Date
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@map("repair_order_labor")
}

// ============================================================
// BILLING & SYNC QUEUES
// ============================================================

model BillingGroup {
  id               String             @id @default(uuid())
  companyId        String             @map("company_id")
  billingProfileId String             @map("billing_profile_id")
  groupKey         String             @map("group_key")
  fieldId          String?            @map("field_id")
  fieldAreaName    String?            @map("field_area_name")
  periodStart      DateTime           @map("period_start") @db.Date
  periodEnd        DateTime           @map("period_end") @db.Date
  status           BillingGroupStatus @default(open)
  ticketCount      Int                @default(0) @map("ticket_count")
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(12, 2)
  qbInvoiceListId  String?            @map("qb_invoice_list_id")
  qbInvoiceNumber  String?            @map("qb_invoice_number")
  enverusInvoiceId String?            @map("enverus_invoice_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  closedAt         DateTime?          @map("closed_at")

  company        Company                @relation(fields: [companyId], references: [id])
  billingProfile CustomerBillingProfile @relation(fields: [billingProfileId], references: [id])
  field          Field?                 @relation(fields: [fieldId], references: [id])
  tickets        ServiceTicket[]
  invoices       Invoice[]

  @@map("billing_groups")
}

// ============================================================
// INVOICES (Sundog's internal billing artifact)
// ============================================================

model Invoice {
  id            String            @id @default(uuid())
  invoiceNumber String            @unique @map("invoice_number") // INV-2026-00001
  status        InvoiceStatus     @default(draft)
  sourceType    InvoiceSourceType @map("source_type")

  // Customer
  companyId   String @map("company_id")
  companyName String @map("company_name") // denormalized snapshot
  billingProfileId String? @map("billing_profile_id")
  billingProfile CustomerBillingProfile? @relation(fields: [billingProfileId], references: [id], onDelete: Restrict)

  // Source references (exactly one should be set based on sourceType)
  billingGroupId    String? @map("billing_group_id")
  shopWorkOrderId   String? @map("shop_work_order_id")
  rentalAgreementId String? @map("rental_agreement_id")

  // Billing references from customer
  poNumber   String? @map("po_number")
  afeNumber  String? @map("afe_number")
  costCenter String? @map("cost_center")
  // Buyer subcompany (Enverus site uuid) + remit-to department, from the profile's sources.
  buyerSiteUuid   String? @map("buyer_site_uuid")
  buyerDepartment String? @map("buyer_department")

  // Internal classification — frozen at invoice creation, drives QB ClassRef on SalesOrder header.
  // Inherited from source ticket(s); one invoice = one class.
  division    ServiceDivision? @map("division")
  isDickinson Boolean          @default(false) @map("is_dickinson")

  // Dates
  invoiceDate DateTime  @map("invoice_date") @db.Date // Service date range or generation date
  dueDate     DateTime? @map("due_date") @db.Date
  periodStart DateTime? @map("period_start") @db.Date // Billing period covered
  periodEnd   DateTime? @map("period_end") @db.Date

  // Totals
  subtotal  Decimal @default(0) @map("subtotal") @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total     Decimal @default(0) @map("total") @db.Decimal(12, 2)

  // ND sales tax (destination-based). taxJurisdictionId references a
  // SalesTaxRate.id (slug); taxRate is the combined rate snapshot frozen at
  // generation so historical invoices keep their rate if the table changes.
  // taxAmount = Σ(taxable line amounts) × taxRate. Jurisdiction is auto-picked
  // from the service location's county, overridable on draft invoices.
  taxJurisdictionId String? @map("tax_jurisdiction_id")
  taxRate           Decimal @default(0) @map("tax_rate") @db.Decimal(6, 5)

  // QB Desktop sync — Sales Order stage
  qbSalesOrderTxnId    String?   @map("qb_sales_order_txn_id") // QB internal TxnID
  qbSalesOrderNumber   String?   @map("qb_sales_order_number") // Human-readable SO#
  qbSalesOrderPushedAt DateTime? @map("qb_sales_order_pushed_at")

  // QB Desktop sync — Invoice stage (after comptroller converts SO→Invoice)
  qbInvoiceTxnId     String?   @map("qb_invoice_txn_id")
  qbInvoiceNumber    String?   @map("qb_invoice_number")
  qbInvoiceCreatedAt DateTime? @map("qb_invoice_created_at")

  // Wave 4 Slice F — QB invoice diff watcher. SP is canonical; the watcher
  // periodically queries QB and flags any divergence. qbDiffNotes shape:
  // { ourTotal, theirTotal, ourLineCount, theirLineCount, checkedAt }.
  // Auto-correction (push InvoiceMod back to QB) is a follow-up slice.
  qbDiffDetectedAt DateTime? @map("qb_diff_detected_at")
  qbDiffNotes      Json?     @map("qb_diff_notes") @db.JsonB
  qbLastCheckedAt  DateTime? @map("qb_last_checked_at")

  // Wave 5 Slice 5A — billing-rules engine. When a rule fires that wants
  // QB to bill a different customer than the actual operator (Tier 1
  // pads → Pale Horse Services pass-through), the override goes here as
  // a customer NAME (looked up against companies on QBWC build). Any
  // line items where qbSkip = true (set by the same rule that wrote
  // this override) are filtered from the QBWC payload — that's how the
  // Tier 1 surcharge line stays on the SP invoice but not in QB.
  qbCustomerOverride String? @map("qb_customer_override")

  // Enverus / OpenInvoice
  enverusSubmittedAt DateTime? @map("enverus_submitted_at")
  enverusReceiptId   String?   @map("enverus_receipt_id")
  enverusStatus      String?   @map("enverus_status")

  // Signature tracking (email-based flow)
  signatureStatus SignatureStatus @default(NONE) @map("signature_status")

  // Approval workflow
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectedById    String?   @map("rejected_by_id")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  // Notes
  notes         String?
  internalNotes String? @map("internal_notes")

  // Modification tracking — detect post-invoice changes
  sourceModifiedAfterSync Boolean   @default(false) @map("source_modified_after_sync")
  sourceModifiedAt        DateTime? @map("source_modified_at")

  customData  Json?    @map("custom_data") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")

  // Relations
  company          Company             @relation(fields: [companyId], references: [id])
  billingGroup     BillingGroup?       @relation(fields: [billingGroupId], references: [id])
  approvedBy       User?               @relation("InvoiceApprover", fields: [approvedById], references: [id])
  rejectedBy       User?               @relation("InvoiceRejector", fields: [rejectedById], references: [id])
  createdBy        User?               @relation("InvoiceCreator", fields: [createdById], references: [id])
  signatureRequest SignatureRequest?
  lineItems        InvoiceLineItem[]
  attachments      InvoiceAttachment[]
  payments         Payment[]

  @@map("invoices")
}

model InvoiceLineItem {
  sourceTicketLineItemId String? @map("source_ticket_line_item_id")
  // The resolved description is the customer-facing billing contract. Keep the
  // source wording only for provenance and classification, never for display.
  originalDescription String? @map("original_description")
  id         String @id @default(uuid())
  invoiceId  String @map("invoice_id")
  lineNumber Int    @map("line_number")

  // What is this line item?
  description String
  productId   String? @map("product_id")
  partNumber  String? @map("part_number")

  // Amounts
  quantity      Decimal @db.Decimal(10, 2)
  unitOfMeasure String? @map("unit_of_measure")
  rate          Decimal @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(12, 2) // quantity * rate (or override)
  isTaxable     Boolean @default(false) @map("is_taxable")

  // Source traceability — which ticket/item generated this line
  sourceTicketId     String? @map("source_ticket_id")
  sourceTicketNumber String? @map("source_ticket_number")
  sourceShopItemId   String? @map("source_shop_item_id")
  sourceRentalItemId String? @map("source_rental_item_id")

  // QB mapping snapshot (what QB item this maps to)
  qbItemListId   String? @map("qb_item_list_id")
  qbItemFullName String? @map("qb_item_full_name")

  // Wave 5 Slice 5A — when true, the QBWC SalesOrder/Invoice builder
  // filters this line out. Set by billing-rules engine for surcharge
  // lines that flow through SP/Enverus but never hit QB (e.g. Tier 1
  // 5% reservation fee, which is collected via Pale Horse pass-through).
  qbSkip Boolean @default(false) @map("qb_skip")

  sortOrder Int      @default(0) @map("sort_order")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation("InvoiceLineProduct", fields: [productId], references: [id])

  @@map("invoice_line_items")
}

// ND/MT sales tax jurisdictions (admin-editable; seeded from the QB
// SalesTaxItem export). Rates are combined state + county + city as a decimal.
// Destination-based: invoice generation auto-selects the row whose `county`
// matches the service location's county (Well→Pad→Field) with
// isCountyDefault = true — i.e. the unincorporated/county rate that applies to
// most well sites. Billing can override per invoice when a site sits inside
// city limits (pick a city row). `qbTaxItemName` maps to the QuickBooks Sales
// Tax Item FullName so QB recomputes tax to match SP.
model SalesTaxRate {
  id              String  @id // slug, e.g. "williston", "williams_co", "nd_state"
  name            String // display label, e.g. "Williston (8%)"
  rate            Decimal @db.Decimal(6, 5) // combined rate as decimal (0.08 = 8%)
  county          String? // ND county this row belongs to (null = state-only / exempt / out-of-state)
  isCountyDefault Boolean @default(false) @map("is_county_default") // the default (unincorporated) rate for `county`
  qbTaxItemName   String? @map("qb_tax_item_name") // QuickBooks Sales Tax Item FullName

  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([county, isCountyDefault])
  @@map("sales_tax_rates")
}

/// Authoritative mirror of QuickBooks' Sales Tax Items + Groups, pulled via
/// QBWC (ItemSalesTaxQueryRq / ItemSalesTaxGroupQueryRq). Lets us reconcile
/// SalesTaxRate.qbTaxItemName against the real QB names instead of guessing —
/// the recurring 3140 "invalid reference to QuickBooks Item Sales Tax" reject.
model QbSalesTaxRecord {
  id             String    @id @default(uuid())
  qbListId       String    @unique @map("qb_list_id")
  fullName       String    @map("full_name") // the exact string QB expects as ItemSalesTaxRef
  recordType     String    @map("record_type") // 'item' | 'group'
  taxRatePercent Decimal?  @map("tax_rate_percent") @db.Decimal(7, 4) // 5 = 5%; null for groups
  isActive       Boolean   @default(true) @map("is_active")
  description    String?
  qbTimeModified DateTime? @map("qb_time_modified")
  lastSyncedAt   DateTime  @default(now()) @map("last_synced_at")

  @@index([fullName])
  @@map("qb_sales_tax_records")
}

/// Mirror of QuickBooks' customer list, pulled via QBWC (paged CustomerQueryRq).
/// The link to a Sundog company lives on Company.qbCustomerListId — a row here
/// whose ListID no company holds is "in QuickBooks, not in Sundog". The pull
/// creates a Company for active top-level customers; jobs, inactive and
/// ambiguous ones wait for review (link / create / ignore).
model QbCustomer {
  id             String    @id @default(uuid())
  qbListId       String    @unique @map("qb_list_id")
  fullName       String    @map("full_name") // "Parent:Job" path; what QB expects as CustomerRef
  name           String
  sublevel       Int       @default(0) // 0 = top-level customer, >0 = job / sub-customer
  parentQbListId String?   @map("parent_qb_list_id")
  isActive       Boolean   @default(true) @map("is_active")
  companyName    String?   @map("company_name")
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  // Reviewed and deliberately not a Sundog customer; hides it from the queue.
  ignored        Boolean   @default(false)
  qbTimeModified DateTime? @map("qb_time_modified")
  lastSyncedAt   DateTime  @default(now()) @map("last_synced_at")

  @@index([fullName])
  @@map("qb_customers")
}

model InvoiceAttachment {
  id            String         @id @default(uuid())
  invoiceId     String         @map("invoice_id")
  fileName      String         @map("file_name")
  fileType      AttachmentType @map("file_type")
  filePath      String         @map("file_path")
  fileSizeBytes Int?           @map("file_size_bytes")
  mimeType      String?        @map("mime_type")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  uploadedById  String?        @map("uploaded_by_id")

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  uploadedBy User?   @relation("InvoiceAttachmentUploader", fields: [uploadedById], references: [id])

  @@map("invoice_attachments")
}

// ============================================================
// SIGNATURE REQUESTS (email-based signing flow)
// ============================================================

model SignatureRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Polymorphic: one of these set, not both
  ticketId  String? @unique @map("ticket_id")
  invoiceId String? @unique @map("invoice_id")

  status SignatureStatus @default(PENDING)

  sentToEmail String   @map("sent_to_email")
