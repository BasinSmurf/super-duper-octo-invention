// ============================================================
// PAYMENTS (Stripe CC, cash, check)
// ============================================================

/// WI-08 -- which counter path collected payment at drop-off.
enum PaidAtDropMethod {
  /// Card taken through Stripe. Produces a QB SalesReceipt automatically.
  stripe
  /// Rung through the in-store Lightspeed POS and re-keyed into QB by hand.
  /// ServicePRO records the reference; it does not assert the money moved.
  lightspeed
}

/// WI-08 -- every Stripe event we have already handled.
///
/// THE IDEMPOTENCY ANCHOR, and the reason it is a table rather than a flag on
/// Payment: Stripe retries a webhook until it gets a 2xx, and "at least once"
/// means a duplicate is normal traffic, not an incident. The event id is the
/// PRIMARY KEY, so a replay collides at INSERT and the handler never runs
/// twice -- the guarantee holds even if two deliveries land concurrently on
/// two API processes, which a check-then-act in application code would not.
model StripeWebhookEvent {
  /// Stripe's own event id (evt_...). Primary key ON PURPOSE.
  id   String @id
  type String

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  /// Set when handling threw. The row still exists, so the replay is still
  /// suppressed -- a failing handler must not turn into an infinite retry that
  /// re-runs side effects. Someone reads this and fixes it forward.
  error String?

  /// The Payment this event resolved to, where it resolved to one.
  paymentId String? @map("payment_id")

  @@index([processedAt])
  @@map("stripe_webhook_events")
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("usd")
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(pending)

  // Stripe fields
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  stripeChargeId        String? @map("stripe_charge_id")
  stripeReceiptUrl      String? @map("stripe_receipt_url")
  cardLast4             String? @map("card_last4")
  cardBrand             String? @map("card_brand")

  // Link to what was paid for (polymorphic — one of these set)
  ticketId        String? @map("ticket_id")
  shopWorkOrderId String? @map("shop_work_order_id")
  invoiceId       String? @map("invoice_id")

  // Customer (required for invoices / account billing)
  companyId         String? @map("company_id")
  customerSignature String? @map("customer_signature") // base64 data URL

  // ND sales tax for counter receipts (direct sale). taxJurisdictionId is a
  // SalesTaxRate.id slug (e.g. "williston"); lineItemsJson is an immutable
  // pre-tax basket snapshot so the QB SalesReceipt is rebuilt from real lines +
  // ItemSalesTaxRef and QB recomputes tax to match the counter total (sending a
  // single tax-inclusive line would double-tax). Shape per line:
  // { productId?, description, quantity, unitPrice, taxable }.
  taxJurisdictionId String? @map("tax_jurisdiction_id")
  lineItemsJson     Json?   @map("line_items_json")

  // How much of `amount` was a card surcharge rather than value received.
  // Split out because counter payments are netted off the work later: the fee
  // went to the card network, not toward the customer's job, so crediting it
  // against the final invoice would refund the surcharge as free work.
  // Null means zero — payments written before this existed carried their fee as
  // an ordinary line, and a backfill would invent a split nobody recorded.
  ccFeeAmount       Decimal? @map("cc_fee_amount") @db.Decimal(12, 2)

  // QB sync
  qbSalesReceiptTxnId String? @map("qb_sales_receipt_txn_id")

  // Meta
  notes       String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  ticket        ServiceTicket? @relation(fields: [ticketId], references: [id])
  shopWorkOrder ShopWorkOrder? @relation(fields: [shopWorkOrderId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id])
  createdBy     User           @relation("PaymentCreator", fields: [createdById], references: [id])

  @@map("payments")
}

model QbSyncQueue {
  id            String           @id @default(uuid())
  entityType    QbSyncEntityType @map("entity_type")
  entityId      String           @map("entity_id")
  action        QbSyncAction
  qbxmlRequest  String?          @map("qbxml_request")
  qbxmlResponse String?          @map("qbxml_response")
  status        QbQueueStatus    @default(pending)
  errorMessage  String?          @map("error_message")
  errorCode     String?          @map("error_code")
  retryCount    Int              @default(0) @map("retry_count")
  priority      Int              @default(5)
  createdAt     DateTime         @default(now()) @map("created_at")
  sentAt        DateTime?        @map("sent_at")
  completedAt   DateTime?        @map("completed_at")

  @@map("qb_sync_queue")
}

model EnverusSyncQueue {
  id                 String             @id @default(uuid())
  entityType         EnverusEntityType  @map("entity_type")
  entityId           String             @map("entity_id")
  target             EnverusTarget
  action             EnverusSyncAction
  endpointUrl        String?            @map("endpoint_url")
  requestPayload     String?            @map("request_payload")
  responsePayload    String?            @map("response_payload")
  responseStatusCode Int?               @map("response_status_code")
  status             EnverusQueueStatus @default(pending)
  enverusItemId      String?            @map("enverus_item_id")
  errorMessage       String?            @map("error_message")
  retryCount         Int                @default(0) @map("retry_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  submittedAt        DateTime?          @map("submitted_at")
  respondedAt        DateTime?          @map("responded_at")

  // Recovered technical failures retain their original error and successful replacement.
  supersededAt DateTime? @map("superseded_at")
  supersededById String? @map("superseded_by_id")

  // Wave 4 Slice E — full-lifecycle status tracking. lastSeenStatus is the
  // raw buyer-side state from the most recent poll; we compare new poll
  // results against it to fire status_flipped events only on actual changes.
  lastSeenStatus String?   @map("last_seen_status")
  lastPolledAt   DateTime? @map("last_polled_at")

  @@map("enverus_sync_queue")
}

// Outbound push queue for BlueLion training certs. entityId is a
// TrainingRosterRecord.id; externalId (`sp-tr-<rosterId>`) is BlueLion's
// idempotency key, so re-sends are deduped on their side and re-enqueues are
// deduped on ours via the unique constraint.
model BlueLionSyncQueue {
  id                 String              @id @default(uuid())
  entityType         BlueLionEntityType  @default(training) @map("entity_type")
  entityId           String              @map("entity_id")
  externalId         String              @unique @map("external_id")
  action             BlueLionSyncAction  @default(push)
  requestPayload     String?             @map("request_payload")
  responsePayload    String?             @map("response_payload")
  responseStatusCode Int?                @map("response_status_code")
  status             BlueLionQueueStatus @default(pending)
  // BlueLion per-record status string: added | skipped | ambiguous | invalid
  resultStatus       String?             @map("result_status")
  blueLionPersonId   String?             @map("bluelion_person_id")
  // For `asset` rows: the BlueLion assetId returned on added/found — the unitId
  // service rows for the same serial must reference.
  blueLionAssetId    String?             @map("bluelion_asset_id")
  trainingSeq        Int?                @map("training_seq")
  // For the `ambiguous` result: the candidate persons BlueLion returned, so a
  // human can pick one and resolve via POST /queue/:id/resolve.
  candidates         Json?
  errorMessage       String?             @map("error_message")
  retryCount         Int                 @default(0) @map("retry_count")
  createdAt          DateTime            @default(now()) @map("created_at")
  submittedAt        DateTime?           @map("submitted_at")
  respondedAt        DateTime?           @map("responded_at")

  @@index([status])
  @@map("bluelion_sync_queue")
}

// The one inbound BlueLion event: a physical wallet card was printed for a
// training (docs/bluelion/SERVICEPRO-CARD-FLAG.md). One row per received flag,
// deduped on the Idempotency-Key header — a re-send returns 2xx without
// re-applying. A reprint arrives as a NEW flag with reissueOf set.
model BlueLionCardFlag {
  id                String   @id @default(uuid())
  idempotencyKey    String   @unique @map("idempotency_key")
  event             String   @default("card.issued")
  cardId            String   @map("card_id")
  personId          String   @map("person_id")
  certCode          String   @map("cert_code")
  issuedOn          DateTime @map("issued_on")
  issuedBy          String?  @map("issued_by")
  templateId        String?  @map("template_id")
  templateVersion   Int?     @map("template_version")
  reissueOf         String?  @map("reissue_of")
  verifyUrl         String?  @map("verify_url")
  payload           Json
  // Which Sundog row got stamped (training_roster_record | fit_test_record),
  // null when no local record matched (flag still stored + acked).
  matchedEntityType String?  @map("matched_entity_type")
  matchedEntityId   String?  @map("matched_entity_id")
  receivedAt        DateTime @default(now()) @map("received_at")

  @@index([personId])
  @@map("bluelion_card_flags")
}

// DB-backed v1 API keys (upgrade of the env V1_API_KEYS store — env keys still
// work; verify checks both). Plaintext (`sp_…`) is shown ONCE at issue and only
// the sha256 hash is stored. Issued/revoked from the /admin/api-keys UI.
model ApiKey {
  id          String    @id @default(uuid())
  label       String
  keyHash     String    @unique @map("key_hash")
  // First characters of the plaintext (e.g. "sp_3fZk") so a key in hand can be
  // matched to its row without storing the secret.
  prefixHint  String?   @map("prefix_hint")
  scopes      Json      @default("[]") // string[] of v1 scopes, or ["*"]
  allowedIps  Json?     @map("allowed_ips") // optional string[] exact-IP allowlist
  revoked     Boolean   @default(false)
  revokedAt   DateTime? @map("revoked_at")
  createdById String?   @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("api_keys")
}

// ============================================================
// SITES (Basin Safety physical service locations)
// ============================================================
//
// A Site is a Basin Safety physical service location (Williston HQ, the
// satellite shop). Distinct from the oilfield Field/Pad/Well/Facility
// hierarchy — those describe where a customer's equipment lives; a Site is
// where Basin services it. Soft-delete only (active = false): shop work
// orders reference Sites forever.

model Site {
  id                     String   @id @default(uuid())
  name                   String
  shortCode              String   @unique @map("short_code") // "WIL", "SBE" — kiosk slugs, label headers
  address                String?
  timezone               String   @default("America/Chicago")
  active                 Boolean  @default(true)
  // ND sales tax — the shop's own jurisdiction (SalesTaxRate.id). Shop-WO
  // deliverables are received at this shop, so its invoices default to this
  // rate (e.g. Dickinson shop → Stark, Williston shop → Williston). Null →
  // ND state-only fallback. Overridable per invoice.
  salesTaxJurisdictionId String?  @map("sales_tax_jurisdiction_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  users             User[]
  intakeWorkOrders  ShopWorkOrder[]
  workOrderItems    ShopWorkOrderItem[]
  printers          Printer[]
  kiosks            Kiosk[]
  rentalAgreements  RentalAgreement[]
  transfersFrom     ShopTransferEvent[] @relation("ShopTransferFromSite")
  transfersTo       ShopTransferEvent[] @relation("ShopTransferToSite")
  transitWorkOrders ShopWorkOrder[]     @relation("ShopWOTransitToSite")

  @@map("sites")
}

