}

/// Where an attachment's bytes actually are, right now.
///
/// This is the two-hop pipeline made explicit rather than assumed. `buffered`
/// means the SP server holds the only durable copy and the capturing device is
/// free to drop its own; `remote` means the object store has a copy whose
/// checksum we re-read and matched, and only then did the buffer copy go.
///
/// A file NEVER leaves a tier before the next tier has acknowledged it and the
/// bytes have been verified. That is the whole point: an optimistic delete on
/// an unreachable object store loses the file, and a photo of a condemned
/// cylinder is not something you can go back and re-take.
enum AttachmentStorageState {
  buffered
  remote
  failed
}

