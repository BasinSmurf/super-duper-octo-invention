// UNUSED. A quantity-on-hand consumables table with no reader: nothing in the
// app, no script, no report. Its only three endpoints (two of them unvalidated
// `data: req.body` pass-throughs) are removed, and the "what gear is in use"
// question it looked like it answered is actually answered by
// SerializedEquipment — serialized units carry status + currentRental, and
// Novara syncs their existence and compliance there, not here.
//
// The TABLE is deliberately left in place rather than dropped: a destructive
// migration to remove something already inert buys nothing and can't be undone
// if any environment turns out to hold rows. Drop it in its own change, after
// confirming prod is empty.
model Inventory {
  id                   String        @id @default(uuid())
  productId            String        @map("product_id")
  stockLocation        StockLocation @map("stock_location")
  assignedToUserId     String?       @map("assigned_to_user_id")
  assignedToLocationId String?       @map("assigned_to_location_id")
  quantityOnHand       Int           @map("quantity_on_hand")
  lastCountedAt        DateTime?     @map("last_counted_at")
  notes                String?

  product        Product @relation(fields: [productId], references: [id])
  assignedToUser User?   @relation(fields: [assignedToUserId], references: [id])

  @@map("inventory")
}

model SerializedEquipment {
  id                  String             @id @default(uuid())
  productId           String             @map("product_id")
  serialNumber        String             @unique @map("serial_number")
  ownership           EquipmentOwnership
  status              EquipmentStatus    @default(available)
  currentPadId        String?            @map("current_pad_id")
  currentWellId       String?            @map("current_well_id")
  currentFacilityId   String?            @map("current_facility_id")
  currentCustomerId   String?            @map("current_customer_id")
  currentRentalId     String?            @map("current_rental_id")
  calibrationDueDate  DateTime?          @map("calibration_due_date") @db.Date
  lastCalibrationDate DateTime?          @map("last_calibration_date") @db.Date
  bumpTestDueDate     DateTime?          @map("bump_test_due_date") @db.Date
  purchaseDate        DateTime?          @map("purchase_date") @db.Date
  warrantyExpiry      DateTime?          @map("warranty_expiry") @db.Date
  safeCoreSerial      String?            @map("safe_core_serial")
  conditionNotes      String?            @map("condition_notes")
  // Decommission record — stamped when a locked inspection outcome = condemn.
  // Lightweight: status flips to `condemned`; these capture when + why.
  condemnedAt         DateTime?          @map("condemned_at")
  condemnReason       String?            @map("condemn_reason")
  // BlueLion asset registration — assetId returned by POST /assets, used as
  // unitId on every subsequent /services push for this unit.
  blueLionAssetId     String?            @map("bluelion_asset_id")
  blueLionSyncedAt    DateTime?          @map("bluelion_synced_at")

  // ── Novara Flex (external equipment-existence + compliance system) ────────
  // Novara is authoritative for compliance. Everything in this block is
  // OVERWRITTEN on every sync run — never hand-edit it in SP, the next tick
  // will stomp it. Fix it in Novara instead.
  //   novaraStatus     — their rollup: uptodate | expiring | expired. Expired
  //                      wins: if any one schedule is expired, so is the unit.
  //   novaraExpiresOn  — soonest expiry across all of the unit's schedules.
  //   novaraSchedules  — per-schedule detail, so the detail page can say WHICH
  //                      inspection lapsed rather than just "expired".
  //   novaraServiceHold— true when THIS sync is what pushed the unit to
  //                      out_of_service, so only the sync may lift it. Without
  //                      it we couldn't tell our own hold apart from a human's.
  novaraEquipmentId     String?   @unique @map("novara_equipment_id")
  novaraStatus          String?   @map("novara_status")
  novaraExpiresOn       DateTime? @map("novara_expires_on") @db.Date
  novaraExpiringOn      DateTime? @map("novara_expiring_on") @db.Date
  novaraLastCompletedOn DateTime? @map("novara_last_completed_on") @db.Date
  novaraInService       Boolean?  @map("novara_in_service")
  novaraServiceHold     Boolean   @default(false) @map("novara_service_hold")
  novaraSchedules       Json?     @map("novara_schedules") @db.JsonB
  novaraSyncedAt        DateTime? @map("novara_synced_at")
  customData          Json?              @map("custom_data") @db.JsonB
  documents           EquipmentDocument[]
  attachments         Attachment[]
  parentEquipmentId   String?            @map("parent_equipment_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // Relations
  product              Product               @relation(fields: [productId], references: [id])
  currentPad           Pad?                  @relation(fields: [currentPadId], references: [id])
  currentWell          Well?                 @relation(fields: [currentWellId], references: [id])
  currentFacility      Facility?             @relation(fields: [currentFacilityId], references: [id])
  currentCustomer      Company?              @relation(fields: [currentCustomerId], references: [id])
  currentRental        RentalAgreement?      @relation(fields: [currentRentalId], references: [id])
  parentEquipment      SerializedEquipment?  @relation("EquipmentChildren", fields: [parentEquipmentId], references: [id])
  childEquipment       SerializedEquipment[] @relation("EquipmentChildren")
  lineItemsInstalled   TicketLineItem[]      @relation("EquipInstalled")
  lineItemsRemoved     TicketLineItem[]      @relation("EquipRemoved")
  rentalAgreementItems RentalAgreementItem[]
  repairOrders         RepairOrder[]
  shopWorkOrderItems   ShopWorkOrderItem[]
  equipmentInspections EquipmentInspection[]

  @@map("serialized_equipment")
}

// ============================================================
// SERVICE TICKETS (The Core)
