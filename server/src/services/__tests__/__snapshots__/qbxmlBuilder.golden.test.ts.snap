// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`qbXML snapshots (regression lock) > InvoiceAdd — no sales tax (untaxed, no tax item) 1`] = `
"<?xml version="1.0" encoding="utf-8"?>
<?qbxml version="13.0"?>
<QBXML>
  <QBXMLMsgsRq onError="stopOnError">
    <InvoiceAddRq>
      <InvoiceAdd>
        <CustomerRef><ListID>80000001-1234567890</ListID></CustomerRef>
        <ClassRef><FullName>D3</FullName></ClassRef>
        <TxnDate>2026-06-15</TxnDate>
        <RefNumber>2026-00042</RefNumber>
        <PONumber>PO-7788</PONumber>
      <InvoiceLineAdd>
        <ItemRef><FullName>Labor</FullName></ItemRef>
        <Desc>Labor</Desc>
        <Quantity>1</Quantity>
        <Rate>100.00</Rate>
        <SalesTaxCodeRef><FullName>Non</FullName></SalesTaxCodeRef>
      </InvoiceLineAdd>
      </InvoiceAdd>
    </InvoiceAddRq>
  </QBXMLMsgsRq>
</QBXML>"
`;

