# ═══════════════════════════════════════════════════════════════
# Sundog — Development Environment
# ═══════════════════════════════════════════════════════════════
# Copy to server/.env for local dev.
# Dev connects to SANDBOX QB + Enverus, prod connects to REAL.
#
# ⚠ ADDING A NEW VAR? IT IS A TWO-FILE CHANGE.
# Dev reads server/.env directly, but prod runs in Docker and the api service
# has NO env_file: — only keys listed under `environment:` in
# docker-compose.prod.yml reach the container. A var added here and set in
# prod's ~/sundog/.env but NOT listed in that compose block is invisible to the
# running app, and the feature silently no-ops with no error anywhere.
# This has shipped broken three times: #43 (gcal), #56 (RingCentral),
# #99 (mailer), plus #98 (S3). Add the passthrough in the SAME commit.
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://sundog:sundog_dev@localhost:5432/sundog?schema=public

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=24h
PIN_SALT_ROUNDS=10

# ── Server ───────────────────────────────────
PORT=3001
HTTPS_PORT=3443
NODE_ENV=development


# ── Google Workspace SSO ─────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=basinsafetyus.com
GOOGLE_SA_KEY_PATH=./certs/service-account.json
GOOGLE_ADMIN_EMAIL=mbartenhagen@basinsafetyus.com
# Real Workspace USER mailbox to send from (Gmail API + the SA above).
# Must be an actual account — a group or alias cannot be impersonated.
GOOGLE_MAIL_FROM=itadmin@basinsafetyus.com

# ── File store (screenshots, equipment docs, ticket PDFs) ──
# local = disk at STORAGE_DIR. Switch to s3 once a bucket exists; the S3_* keys
# are read only when STORAGE_DRIVER=s3, and it falls back to local otherwise.
# Upload size cap is fixed at 20MB in code (routes/files.ts) — not an env var.
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=              # set for S3-compatible stores (MinIO, R2, Backblaze)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1     # required by most non-AWS S3-compatible stores

# ── Enverus OpenInvoice ──────────────────────
# DEV always uses SANDBOX
ENVERUS_BASE_URL=https://onboard-api.openinvoice.com
ENVERUS_PFX_PATH=./certs/enverus/envkeys.pfx
ENVERUS_PFX_PASSPHRASE=
ENVERUS_CERT_PATH=./certs/enverus/BasinSafety_Public.pem
ENVERUS_SUPPLIER_DUNS=016937650
ENVERUS_HMAC_SECRET=
ENVERUS_TIMEOUT_MS=30000
ENVERUS_MAX_RETRIES=3

# ── QuickBooks Web Connector ─────────────────
# false = answer every QBWC poll with "none" (use when QB won't launch on the host)
QBWC_ENABLED=true
QBWC_USERNAME=sundog
QBWC_PASSWORD=change-me
QBWC_FILE_ID=
QBWC_OWNER_ID=
# How this instance is listed in the Web Connector. QBWC keys its app list on
# AppName + FileID, so a second instance on the same QB host (see
# server/.env.sandbox.example) must differ in both or it overwrites this one.
QBWC_APP_NAME=Service Pro - Basin Safety
# Absolute path to the .QBW this instance may touch, as the QB host sees it.
# Empty = "whatever company file is open", which is right for prod: that host
# only ever opens the live books. Anything sharing the host must name its own
# file here — QB refuses the session if a different file is open, so a wrong
# path fails loudly instead of writing to the wrong ledger.
QBWC_COMPANY_FILE=
# Auto-run interval baked into the .qwc, in minutes. 0 omits the <Scheduler>
# block entirely, so the app only runs when someone clicks Update Selected.
# Set 0 on any instance sharing a QB host with another: QuickBooks opens one
# company file at a time, so two scheduled registrations bound to different
# files fight, while two manual ones just run when their file is open.
QBWC_RUN_EVERY_N_MINUTES=5

# ── Stripe ───────────────────────────────────
# DEV must use sk_test_ / pk_test_ keys — NEVER live keys!
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret (whsec_...). WI-08: Stripe tells the server the money
# moved, so a QB receipt is written even when the browser never gets to call
# /confirm -- an iPad off the wifi mid-payment used to mean a charged card and
# an unpaid-looking ticket.
#
# Get it from the Stripe dashboard when you register the endpoint:
#   https://<public-host>/api/stripe/webhook
# listening for payment_intent.succeeded, payment_intent.payment_failed,
# charge.refunded.
#
# Without it the endpoint refuses every request -- deliberately. An unverified
# webhook is an unauthenticated POST that writes payment records.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── RingCentral Team Messaging (auto-dispatch notifications) ──
# Incoming webhook URL(s) — RingCentral app > team chat > Add Integration >
# Incoming Webhook. No OAuth app needed. Leave unset to disable (self-skips).
# RINGCENTRAL_WEBHOOK_URL is a single-channel fallback used when the
# billing/dispatch/intake-specific vars below aren't set.
# RINGCENTRAL_WEBHOOK_URL=
# RINGCENTRAL_BILLING_WEBHOOK_URL=
# RINGCENTRAL_DISPATCH_WEBHOOK_URL=
# RINGCENTRAL_INTAKE_WEBHOOK_URL=
# Optional: https:// URL RingCentral will fetch to show as the post's icon.
# RINGCENTRAL_ICON_URL=

# ── Email (daily digest — not yet implemented) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# DIGEST_FROM_EMAIL=sundog@basinsafetyus.com

# ── Novara Flex (equipment existence + inspection compliance) ──
# One-way pull: Novara -> ServicePRO. Nothing is pushed back.
# Token is generated at https://my.novaraflex.com/api (Manage API permission,
# max 5 active per site). It grants FULL read/write on the Novara account and
# must never reach the client bundle — server-side only.
# Unset = the whole integration self-skips (no job, admin page reports
# "not configured").
# NOVARA_API_TOKEN=
# NOVARA_API_URL=https://api.novaraflex.com
# NOVARA_TIMEOUT_MS=20000
# NOVARA_MAX_RETRIES=3
# Their rate limit is ~80 req/min for the WHOLE customer account, shared across
# every token they've issued. 1000ms spacing keeps us at 60/min with headroom
# for whatever else is calling that account. Raise the interval, don't lower it.
# NOVARA_MIN_REQUEST_INTERVAL_MS=1000
# Full pull cadence. A run costs one request per equipment type, so hourly is
# cheap even with a large catalog.
# NOVARA_SYNC_INTERVAL_MS=3600000
# NOVARA_SYNC_ENABLED=false
